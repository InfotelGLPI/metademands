{#-
 # Custom values of a field (FieldCustomvalue::showFieldCustomValues()).
 #
 # Expected context:
 #  - show_header, has_duplicates, is_not_sequential: header and rank warnings
 #  - form_url, fields_id: target of the "fix the ranks" form
 #  - params: field parameters; the rows depend on the field type and are printed by
 #    FieldCustomvalue::showCustomValueRows() (the field classes print their own rows)
-#}

{% if has_duplicates %}
    <div class="alert alert-warning d-flex align-items-center mb-2">
        <i class="ti ti-alert-triangle me-2" style="font-size:2em;color:orange;"></i>
        <span>{{ __('You have duplicates rank!', 'metademands') }}</span>
    </div>
{% endif %}

{% if is_not_sequential %}
    <div class="alert alert-warning d-flex align-items-center mb-2">
        <i class="ti ti-alert-triangle me-2" style="font-size:2em;color:orange;"></i>
        <div>
            <p class="mb-1">{{ __('The ranks are not ordered correctly, you will not be able to order them!', 'metademands') }}</p>
            {% set fix_label = _x('button', 'Do you want to fix them ? Warning you must check your options after!', 'metademands') %}
            <form method="post" action="{{ form_url }}">
                <input type="hidden" name="plugin_metademands_fields_id" value="{{ fields_id }}">
                <button type="submit" name="fixranks" value="1" class="btn btn-warning" title="{{ fix_label }}">
                    <i class="ti ti-settings"></i>
                    <span class="sr-only">{{ fix_label }}</span>
                </button>
            </form>
        </div>
    </div>
{% endif %}

<table class="tab_cadre_fixe w-100">
    {% if show_header %}
        <tr class="tab_bg_1">
            <th colspan="5">{{ __('Custom values', 'metademands') }}</th>
        </tr>
    {% endif %}
    {% do call('GlpiPlugin\\Metademands\\FieldCustomvalue::showCustomValueRows', [params]) %}
</table>
