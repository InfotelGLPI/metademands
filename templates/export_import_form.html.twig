{#
 # Metademand XML/JSON import form.
 #
 # Expected context:
 #  - target: form action URL
 #}

<form name="import_file_form" id="import_file_form" method="post"
      action="{{ target }}" enctype="multipart/form-data">
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="card-title">{{ __('Import', 'metademands') }}</h5>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <label class="col-form-label col-sm-4" for="meta_file">
                    {{ __('Metademand file to import', 'metademands') }}
                </label>
                <div class="col-sm-8">
                    <input class="form-control" type="file" id="meta_file" name="meta_file" accept="text/*">
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
            {{ call('Html::submit', [__('Import', 'metademands'), {
                'name': 'import_file',
                'class': 'btn btn-primary'
            }])|raw }}
        </div>
    </div>
    {# closeForm() emits the CSRF token and the closing </form> tag #}
    {{ call('Html::closeForm', [false])|raw }}
