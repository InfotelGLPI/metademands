{#
 # Metademand XML import form, first step: the file is checked and its summary displayed
 # (export_import_summary.html.twig) before it is imported.
 #
 # Expected context:
 #  - target: form action URL
 #}

<form name="import_file_form" id="import_file_form" method="post"
      action="{{ target }}" enctype="multipart/form-data">
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="card-title">{{ __('Import', 'metademands') }}</h5>
        </div>
        <div class="card-body">
            <div class="row mb-2">
                <label class="col-form-label col-sm-4" for="meta_file">
                    {{ __('Metademand file to import', 'metademands') }}
                </label>
                <div class="col-sm-8">
                    <input class="form-control" type="file" id="meta_file" name="meta_file" accept="text/*">
                </div>
            </div>
        </div>
        <div class="card-footer text-center">
            <button type="submit" name="analyze_file" value="1" class="btn btn-primary">
                <i class="ti ti-file-search"></i>
                <span>{{ __('Check the file', 'metademands') }}</span>
            </button>
        </div>
    </div>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
