<div class="left">
    <table class="tab_cadre_fixe">
        <th class="left">{{ __('Metademands global status', 'metademands') }}</th>
        </tr>
        <tr class="tab_bg_2">
            <td class="left">{{ global_status_form|raw }}</td>
        </tr>
    </table>
</div>

<div class="left">
    <table class="tab_cadre_fixe">
        {% if duplicates_has %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('Duplicates fields options', 'metademands') }}</th>
            </tr>
            <tr class="tab_bg_2">
                <td class="left">
            {% for row in duplicates_rows %}
                <table class="tab_cadre_fixe">
                    <tr class="tab_bg_2">
                        <th class="left" width="50%">{{ __('Field') }}</th>
                        <th class="left">{{ _n('Meta-Demand', 'Meta-Demands', 1, 'metademands') }}</th>
                        <th class="left">{{ __('Number of duplicates', 'metademands') }}</th>
                    </tr>
                    <tr class="tab_bg_2">
                        <td class="left">{{ row.field_link|raw }}</td>
                        <td class="left">{{ row.meta_name }}</td>
                        <td class="left">{{ row.nbr }}</td>
                    </tr>
                </table>
            {% endfor %}
        {% else %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('No duplicates founded', 'metademands') }}</th>
            </tr>
        {% endif %}
    </table>
</div>

<br>
<div class="left">
    <table class="tab_cadre_fixe">
        {% if empty_options_has %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('Empty fields options', 'metademands') }}</th>
            </tr>
            <tr class="tab_bg_2">
                <td class="left">
            {% for row in empty_options_rows %}
                <table class="tab_cadre_fixe">
                    <tr class="tab_bg_2">
                        <th class="left" width="50%">{{ __('Field') }}</th>
                        <th class="left">{{ _n('Meta-Demand', 'Meta-Demands', 1, 'metademands') }}</th>
                        <th class="center"></th>
                    </tr>
                    <tr class="tab_bg_2">
                        <td class="left">{{ row.field_link|raw }}</td>
                        <td class="left">{{ row.meta_name }}</td>
                        <td class="center">{{ row.purge_form|raw }}</td>
                    </tr>
                </table>
            {% endfor %}
        {% else %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('No empty field options founded', 'metademands') }}</th>
            </tr>
        {% endif %}
    </table>
</div>

<br>
<div class="left">
    <table class="tab_cadre_fixe">
        {% if empty_cv_has %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('Empty custom values', 'metademands') }}</th>
            </tr>
            <tr class="tab_bg_2">
                <td class="left">
                {{ empty_cv_rows_html|raw }}
        {% else %}
            <tr class="tab_bg_2">
                <th class="left">{{ __('No empty custom values founded', 'metademands') }}</th>
            </tr>
        {% endif %}
    </table>
</div>

<br>
<div class="left">
    <table class="tab_cadre_fixe">
        {% if ranks_fields_found %}
            {% if ranks_has %}
                <tr class="tab_bg_2">
                    <th class="left">{{ __('Ranks problem with fields', 'metademands') }}</th>
                </tr>
                <tr class="tab_bg_2">
                    <td class="left">
                {% for row in ranks_rows %}
                    <table class="tab_cadre_fixe">
                        <tr class="tab_bg_2">
                            <th class="left" width="50%">{{ __('Field') }}</th>
                            <th class="left">{{ _n('Meta-Demand', 'Meta-Demands', 1, 'metademands') }}</th>
                            <th class="center"></th>
                        </tr>
                        <tr class="tab_bg_2">
                            <td class="left">{{ row.field_link|raw }}</td>
                            <td class="left">{{ row.meta_name }}</td>
                            <td class="right">{{ row.fix_form|raw }}</td>
                        </tr>
                    </table>
                {% endfor %}
            {% else %}
                <tr class="tab_bg_2">
                    <th class="left">{{ __('No problems with ranks found', 'metademands') }}</th>
                </tr>
            {% endif %}
    </table>
</div>
        {% endif %}
