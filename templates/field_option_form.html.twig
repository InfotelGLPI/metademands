{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{#-
 # Form of a condition of a field (FieldOption::showForm()).
 #
 # Expected context:
 #  - option, field, params: the option, its field and the option values; the rows
 #    depend on the field type and are printed by FieldOption::showOptionRows()
 #    (the field classes and the plugins print their own rows)
 #  - show_submit: false when the field saves its options itself
-#}

<form name="form" method="post" action="{{ form_action }}">
    {{ inputs.hidden('plugin_metademands_fields_id', field_parent_id) }}
    {% if not is_new %}{{ inputs.hidden('id', field_id) }}{% endif %}

    <table class="tab_cadre w-100">
        <tbody>
        {% do call([option, 'showOptionRows'], [field, params]) %}
        </tbody>
    </table>

    {% if show_submit %}
        <div class="d-flex justify-content-end mt-2">
            <button class="btn btn-primary" type="submit"
                    name="{{ is_new ? 'add' : 'update' }}" value="1">
                <i class="ti ti-device-floppy"></i>
                <span>{{ is_new ? _x('button', 'Add') : _x('button', 'Save') }}</span>
            </button>
        </div>
    {% endif %}
</form>
