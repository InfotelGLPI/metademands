{#
 # Response of ajax/dropdownMassiveActionField.php: the widget matching the search
 # option picked in the massive-action form, plus the hidden input carrying its name.
 #
 # Expected context:
 #  - use_table:   whether the widget needs the legacy two-cell table layout
 #  - itemtype:    itemtype of the massive action
 #  - search:      search option of the picked field
 #  - input:       request parameters (value, itemtype_used, relative_dates…)
 #  The widget is printed in place by TicketField::showMassiveActionFieldWidget().
 #  - field_name:  value of the `field` hidden input, the name of the widget
 #}

{% if use_table %}
    <table>
        <tr>
            <td>{% do call('GlpiPlugin\\Metademands\\TicketField::showMassiveActionFieldWidget', [itemtype, search, input]) %}</td>
            <td><input type="hidden" name="field" value="{{ field_name }}"></td>
        </tr>
    </table>
{% else %}
    {% do call('GlpiPlugin\\Metademands\\TicketField::showMassiveActionFieldWidget', [itemtype, search, input]) %}
    <input type="hidden" name="field" value="{{ field_name }}">
{% endif %}
