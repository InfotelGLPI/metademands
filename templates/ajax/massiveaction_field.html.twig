{#
 # Response of ajax/dropdownMassiveActionField.php: the widget matching the search
 # option picked in the massive-action form, plus the hidden input carrying its name.
 #
 # Expected context:
 #  - use_table:   whether the widget needs the legacy two-cell table layout
 #  - widget_html: the widget, written by the core helpers of the endpoint
 #  - hidden_html: the `field` hidden input, built by Html::hidden()
 #}

{% if use_table %}
    <table>
        <tr>
            <td>{{ widget_html|raw }}</td>
            <td>{{ hidden_html|raw }}</td>
        </tr>
    </table>
{% else %}
    {{ widget_html|raw }}
    {{ hidden_html|raw }}
{% endif %}
