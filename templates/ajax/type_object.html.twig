{#
 # Fragment returned by ajax/type_object.php when the "object to create" of a
 # metademand changes. It lands in a full-width column of the metademand form, so it
 # follows the same `fields.*` formalism instead of the `<tr><td>` the legacy
 # endpoint emitted into a Bootstrap grid.
 #
 # Expected context:
 #  - mode:                    'ticket', 'category' or 'plugin'
 #  - type_dropdown_html:      ticket type dropdown, with its onchange script
 #  - category_dropdown_html:  ITIL category dropdown (problem / change)
 #  - plugin_html:             dropdown contributed by another plugin
 #}

{% import "components/form/fields_macros.html.twig" as fields %}

<div class="row flex-row align-items-start flex-grow-1">
    {% if mode == 'ticket' %}
        {{ fields.htmlField('type', type_dropdown_html, _n('Type', 'Types', 1)) }}
        {{ fields.ajaxField('show_category_by_type', '', __('Category')) }}
    {% elseif mode == 'category' %}
        {{ fields.htmlField('itilcategories_id', category_dropdown_html, __('Category')) }}
    {% elseif mode == 'plugin' %}
        {{ plugin_html|raw }}
    {% endif %}
</div>
