{#
 # "Wizard creation" tab of a metademand (Field::listFields()): the blocks stacked as cards,
 # one compact row per field, the preview of the selected block next to them.
 # Behaviours (search, type filter, preview, selection, drag and drop between blocks, add
 # modals, purge confirmation) are read from the data-md-* attributes by
 # public/scripts/field_list.js.
 #
 # panels      - blocks: id, name, rows, fix_orders, warning_count, is_conditional,
 #               condition_sources (id, label of the fields that show the block)
 # to_complete - fields with a warning: id, label, warnings
 # type_filter - type => label of the types present in the list
 #}
<div class="md-builder" data-md-field-list="{{ meta_id }}"
     data-md-field-list-preview-url="{{ preview_url }}"
     data-md-field-list-move-url="{{ move_url }}"
     data-md-field-list-mandatory-url="{{ mandatory_url }}"
     data-md-field-list-mandatory-error="{{ __('The field could not be updated.', 'metademands') }}"
     data-md-field-list-move-error="{{ __('The field could not be moved: the list is reloaded.', 'metademands') }}"
     data-md-field-list-parameters-url="{{ parameters_url }}"
     data-md-field-list-rename-url="{{ rename_url }}"
     data-md-field-list-rename-error="{{ __('The label could not be saved.', 'metademands') }}"
     data-md-field-list-parameters-error="{{ __('The parameters could not be saved.', 'metademands') }}"
     data-md-label-parameters="{{ _n('Parameter', 'Parameters', 2, 'metademands') }}"
     data-md-label-full-form="{{ __('Open the whole form', 'metademands') }}"
     data-md-label-close="{{ __('Close') }}"
     data-md-label-loading="{{ __('Loading...') }}">
    {% if add is not null %}
        <div class="modal fade" id="{{ add.modal_new_id }}" tabindex="-1">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ __('Add a new field', 'metademands') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body"></div>
                </div>
            </div>
        </div>
        <div class="modal fade" id="{{ add.modal_existing_id }}" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ __('Add an existing field', 'metademands') }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body"></div>
                </div>
            </div>
        </div>
    {% endif %}

    {# Toolbar #}
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="d-flex flex-wrap align-items-center gap-2">
                <div class="input-icon md-search">
                    <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                    <input type="search" class="form-control" data-md-field-search
                           placeholder="{{ __('Search a field (label, ID)', 'metademands') }}"
                           aria-label="{{ __('Search a field (label, ID)', 'metademands') }}">
                </div>
                <select class="form-select w-auto" data-md-field-type-filter aria-label="{{ __('Field type', 'metademands') }}">
                    <option value="">{{ __('All types', 'metademands') }}</option>
                    {% for type, type_label in type_filter %}
                        <option value="{{ type }}">{{ type_label }}</option>
                    {% endfor %}
                </select>
                {% if panels is not empty %}
                    <label class="form-check form-switch m-0 ms-1">
                        <input class="form-check-input" type="checkbox" checked data-md-field-toggle-preview>
                        <span class="form-check-label">{{ __('Preview') }}</span>
                    </label>
                {% endif %}
                {% if canedit and panels is not empty %}
                    <label class="form-check form-switch m-0 ms-1">
                        <input class="form-check-input" type="checkbox" data-md-field-toggle-select>
                        <span class="form-check-label">{{ __('Multiple selection', 'metademands') }}</span>
                    </label>
                {% endif %}
                {% if add is not null %}
                    <div class="ms-auto d-flex gap-2">
                        <button type="button" class="btn btn-outline-secondary"
                                data-md-field-add="{{ add.modal_existing_id }}"
                                data-md-field-add-url="{{ add.url_existing }}"
                                data-md-field-add-params="{{ add.params|json_encode }}">
                            <i class="ti ti-copy me-1"></i>{{ __('Add an existing field', 'metademands') }}
                        </button>
                        <button type="button" class="btn btn-primary"
                                data-md-field-add="{{ add.modal_new_id }}" data-md-field-add-new
                                data-md-field-add-url="{{ add.url_new }}"
                                data-md-field-add-params="{{ add.params|json_encode }}">
                            <i class="ti ti-plus me-1"></i>{{ __('Add a new field', 'metademands') }}
                        </button>
                        <a href="{{ render_url }}" class="btn btn-outline-secondary" target="_blank" rel="noopener"
                           title="{{ __('Open the form as the requesters fill it, in a new tab', 'metademands') }}">
                            <i class="ti ti-eye me-1"></i>{{ __('Preview') }}
                        </a>
                    </div>
                {% else %}
                    {# Read only: the preview still opens the form #}
                    <div class="ms-auto">
                        <a href="{{ render_url }}" class="btn btn-outline-secondary" target="_blank" rel="noopener">
                            <i class="ti ti-eye me-1"></i>{{ __('Preview') }}
                        </a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Fields to complete, each one named and reachable #}
    {% if to_complete is not empty %}
        <div class="alert alert-warning d-flex align-items-start gap-2 py-2">
            <i class="ti ti-alert-triangle mt-1"></i>
            <div>
                <b>{{ _n('%d field to complete', '%d fields to complete', to_complete|length, 'metademands')|format(to_complete|length) }}</b> :
                {% for field in to_complete %}
                    <a href="#md-field-{{ field.id }}" class="alert-link" data-md-field-goto="{{ field.id }}">{{ field.label }}</a>
                    ({{ field.warnings|join(', ') }}){{ not loop.last ? ',' }}
                {% endfor %}
            </div>
        </div>
    {% endif %}

    {% if panels is empty %}
        <div class="card">
            <div class="card-body text-center text-muted py-5">
                <i class="ti ti-forms fs-1 d-block mb-2"></i>
                {{ __('This form has no field yet.', 'metademands') }}
            </div>
        </div>
    {% else %}
        <div class="row g-3">
            {# Outline of the form #}
            <div class="col-12 col-xl-2 d-none d-xl-block" data-md-field-outline>
                <div class="card md-sticky">
                    <div class="card-header py-2"><h4 class="card-title m-0">{{ _n('Block', 'Blocks', 2, 'metademands') }}</h4></div>
                    <div class="list-group list-group-flush small">
                        {% for panel in panels %}
                            <a href="#md-block-{{ panel.id }}" class="list-group-item list-group-item-action d-flex align-items-center gap-1"
                               data-md-block-goto="{{ panel.id }}">
                                <span class="text-truncate">{{ panel.name }}</span>
                                <span class="ms-auto d-flex gap-1">
                                    {% if panel.warning_count > 0 %}
                                        <span class="badge bg-yellow text-yellow-fg" title="{{ __('Fields to complete', 'metademands') }}">{{ panel.warning_count }}</span>
                                    {% endif %}
                                    <span class="badge bg-secondary-lt" data-md-block-count="{{ panel.id }}">{{ panel.rows|length }}</span>
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>

            {# Blocks and fields #}
            <div class="col-12 col-xl-6" data-md-field-structure>
                {% if canedit %}
                    {# raw: massive actions, no core macro; the form stays in this column, the
                       preview next to it holding forms of its own #}
                    {{ call('Html::getOpenMassiveActionsForm', [massive_container])|raw }}
                    <div class="d-none mb-2" data-md-field-massive>
                        {# raw: massive actions, no core macro #}
                        {{ call('Html::showMassiveActions', [{'item': itemtype, 'container': massive_container, 'display': false}])|raw }}
                    </div>
                {% endif %}

                {% for panel in panels %}
                    <div class="card md-block mb-3" id="md-block-{{ panel.id }}" data-md-block="{{ panel.id }}"
                         data-md-block-name="{{ panel.name }}">
                        <div class="card-header py-2 d-flex flex-wrap align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-ghost-secondary p-1" data-bs-toggle="collapse"
                                    data-bs-target="#md-block-body-{{ panel.id }}" aria-expanded="true"
                                    title="{{ __('Fold / unfold', 'metademands') }}">
                                <i class="ti ti-chevron-down md-chevron"></i>
                            </button>
                            <h3 class="card-title m-0">{{ panel.name }}</h3>
                            <span class="badge bg-secondary-lt" title="{{ _n('Field', 'Fields', 2, 'metademands') }}">
                                <i class="ti ti-forms me-1"></i><span data-md-block-count="{{ panel.id }}">{{ panel.rows|length }}</span>
                            </span>
                            {% if panel.is_conditional %}
                                <span class="badge bg-purple-lt" title="{{ __('Hidden until a field shows it', 'metademands') }}">
                                    <i class="ti ti-eye-off me-1"></i>{{ __('Conditional block', 'metademands') }}
                                </span>
                                <span class="small text-muted">
                                    {{ __('shown by', 'metademands') }}
                                    {% for source in panel.condition_sources %}
                                        <a href="#md-field-{{ source.id }}" data-md-field-goto="{{ source.id }}"
                                           title="{{ __('Go to the field', 'metademands') }}">{{ source.label }}</a>
                                        <span class="text-muted">#{{ source.id }}</span>{{ not loop.last ? ',' }}
                                    {% endfor %}
                                </span>
                            {% endif %}
                            {% if panel.warning_count > 0 %}
                                <span class="badge bg-yellow text-yellow-fg">
                                    <i class="ti ti-alert-triangle me-1"></i>{{ _n('%d to complete', '%d to complete', panel.warning_count, 'metademands')|format(panel.warning_count) }}
                                </span>
                            {% endif %}
                            <div class="ms-auto d-flex gap-1">
                                {% if canedit and panel.fix_orders %}
                                    <button type="submit" form="md-fix-orders-{{ meta_id }}" name="rank" value="{{ panel.id }}"
                                            class="btn btn-sm btn-warning"
                                            title="{{ __('The fields are not ordered correctly, you will not be able to order them!', 'metademands') }}">
                                        <i class="ti ti-sort-ascending-numbers me-1"></i>{{ _x('button', 'Do you want to fix them ?', 'metademands') }}
                                    </button>
                                {% endif %}
                                <button type="button" class="btn btn-sm btn-ghost-secondary" data-md-block-preview="{{ panel.id }}"
                                        title="{{ __('Block overview', 'metademands') }}">
                                    <i class="ti ti-eye"></i>
                                </button>
                            </div>
                        </div>
                        <div class="collapse show" id="md-block-body-{{ panel.id }}">
                            <div class="md-fields" data-md-fields data-md-rank="{{ panel.id }}">
                                {% for row in panel.rows %}
                                    <div class="md-field" id="md-field-{{ row.id }}" data-md-field-id="{{ row.id }}"
                                         data-md-type="{{ row.type }}"
                                         data-md-search="{{ (row.label ~ ' ' ~ row.id ~ ' ' ~ row.type_label)|lower }}">
                                        {% if canedit %}
                                            <span class="md-grip" title="{{ __('Move', 'metademands') }}"><i class="ti ti-grip-vertical"></i></span>
                                            <span class="md-check d-none">
                                                {# raw: massive actions, no core macro #}
                                                {{ call('Html::getMassiveActionCheckBox', [itemtype, row.id])|raw }}
                                            </span>
                                        {% endif %}
                                        <span class="md-type" title="{{ row.base_type_label }}"><i class="ti {{ row.icon }}"></i></span>
                                        <div class="md-label">
                                            {% if canedit %}
                                                {# Renamed in place by the button (field_list.js -> ajax/fieldname.php); the
                                                 # label itself stays the link to the field form #}
                                                <div class="md-title-line d-flex align-items-center gap-1">
                                                    <a href="{{ row.url }}" class="md-title" data-md-field-label>{{ row.label }}</a>
                                                    <button type="button" class="btn btn-sm btn-ghost-secondary md-rename p-0"
                                                            data-md-field-rename="{{ row.id }}" title="{{ __('Rename', 'metademands') }}"
                                                            aria-label="{{ __('Rename', 'metademands') }}">
                                                        <i class="ti ti-cursor-text"></i>
                                                    </button>
                                                </div>
                                            {% else %}
                                                <a href="{{ row.url }}" class="md-title">{{ row.label }}</a>
                                            {% endif %}
                                            <div class="md-meta">
                                                #{{ row.id }} · {{ row.type_label }}
                                                {%- if row.debug_order is not null %} · {{ __('Order', 'metademands') }} {{ row.debug_order }}{% endif %}
                                            </div>
                                        </div>
                                        <div class="md-badges d-flex flex-wrap justify-content-end gap-1">
                                            {% for warning in row.warnings %}
                                                <span class="badge bg-yellow text-yellow-fg"><i class="ti ti-alert-triangle me-1"></i>{{ warning }}</span>
                                            {% endfor %}
                                            {% if canedit and row.can_be_mandatory %}
                                                {# Switched in place (field_list.js -> ajax/fieldmandatory.php) #}
                                                <button type="button" class="badge border-0 md-mandatory {{ row.is_mandatory ? 'bg-red-lt' : 'bg-secondary-lt text-secondary' }}"
                                                        data-md-field-mandatory="{{ row.id }}"
                                                        aria-pressed="{{ row.is_mandatory ? 'true' : 'false' }}"
                                                        data-md-label-on="{{ __('Mandatory', 'metademands') }}"
                                                        data-md-label-off="{{ __('Optional', 'metademands') }}"
                                                        title="{{ __('Click to make the field mandatory or optional', 'metademands') }}">
                                                    <i class="ti {{ row.is_mandatory ? 'ti-asterisk' : 'ti-circle-dashed' }} me-1"></i>
                                                    <span>{{ row.is_mandatory ? __('Mandatory', 'metademands') : __('Optional', 'metademands') }}</span>
                                                </button>
                                            {% elseif row.is_mandatory %}
                                                <span class="badge bg-red-lt">{{ __('Mandatory', 'metademands') }}</span>
                                            {% endif %}
                                            {% if row.is_basket %}
                                                <span class="badge bg-orange-lt" title="{{ __('Display into the basket', 'metademands') }}">
                                                    <i class="ti ti-basket me-1"></i>{{ __('Basket', 'metademands') }}
                                                </span>
                                            {% endif %}
                                            {% if row.object_field_label is not empty %}
                                                <span class="badge bg-azure-lt" title="{{ __('Use this field as object field', 'metademands') }}">
                                                    <i class="ti ti-ticket me-1"></i>{{ row.object_field_label }}
                                                </span>
                                            {% endif %}
                                            {% if row.value_to_check_label is not empty %}
                                                <span class="badge bg-purple-lt" title="{{ __('Value to check', 'metademands') }} : {{ row.value_to_check_label }}">
                                                    <i class="ti ti-arrow-fork me-1"></i>{{ row.value_to_check_label|length > 40 ? row.value_to_check_label|slice(0, 40) ~ '…' : row.value_to_check_label }}
                                                    {%- for block in row.shown_blocks %} → {{ __('Block', 'metademands') }} {{ block }}{% endfor %}
                                                </span>
                                            {% endif %}
                                            {% for task_name in row.task_names %}
                                                <span class="badge bg-green-lt" title="{{ __('Launch a task with the field', 'metademands') }}">
                                                    <i class="ti ti-subtask me-1"></i>{{ task_name }}
                                                </span>
                                            {% endfor %}
                                        </div>
                                        <div class="md-actions d-flex">
                                            {% if canedit %}
                                                {# Parameters edited in a panel under the line (field_list.js) #}
                                                <button type="button" class="btn btn-sm btn-ghost-secondary"
                                                        data-md-field-parameters="{{ row.id }}" aria-expanded="false"
                                                        title="{{ _n('Parameter', 'Parameters', 2, 'metademands') }}">
                                                    <i class="ti ti-adjustments-horizontal"></i>
                                                </button>
                                            {% endif %}
                                            <a href="{{ row.url }}" class="btn btn-sm btn-ghost-primary" title="{{ __('Edit') }}"><i class="ti ti-pencil"></i></a>
                                            {% if canedit %}
                                                {# Owned by the purge form below: forms cannot nest in the massive actions one #}
                                                <button type="submit" form="{{ purge_form_id }}" name="id" value="{{ row.id }}"
                                                        class="btn btn-sm btn-ghost-danger" data-md-field-purge
                                                        data-md-field-purge-confirm="{{ __('Are you sure you want to delete this field ?', 'metademands') }}"
                                                        title="{{ _x('button', 'Delete permanently') }}">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                            {% if add is not null %}
                                <button type="button" class="md-add-here"
                                        data-md-field-add="{{ add.modal_new_id }}"
                                        data-md-field-add-url="{{ add.url_new }}"
                                        data-md-field-add-params="{{ add.params|json_encode }}"
                                        data-md-field-add-rank="{{ panel.id }}">
                                    <i class="ti ti-plus me-1"></i>{{ __('Add a field in this block', 'metademands') }}
                                </button>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}

                {% if canedit %}
                    </form>
                {% endif %}
            </div>

            {# Preview of the selected block #}
            <div class="col-12 col-xl-4" data-md-field-side>
                <div class="card md-sticky">
                    <div class="card-header py-2">
                        <h4 class="card-title m-0">
                            <i class="ti ti-eye me-1"></i>{{ __('Block overview', 'metademands') }} — <span data-md-preview-title></span>
                        </h4>
                    </div>
                    <div class="card-body md-preview" data-md-preview-body>
                        <div class="text-muted">{{ __('Loading...') }}</div>
                    </div>
                </div>
            </div>
        </div>

        {% if canedit %}
            <form id="{{ purge_form_id }}" method="post" action="{{ form_url }}">
                <input type="hidden" name="plugin_metademands_metademands_id" value="{{ meta_id }}">
                <input type="hidden" name="purge" value="1">
            </form>
            <form id="md-fix-orders-{{ meta_id }}" method="post" action="{{ form_url }}">
                <input type="hidden" name="plugin_metademands_metademands_id" value="{{ meta_id }}">
                <input type="hidden" name="fixorders" value="1">
            </form>
        {% endif %}
    {% endif %}
</div>
