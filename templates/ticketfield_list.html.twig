{% if not has_rows %}
    <div class="center first-bloc">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <td class="center">{{ __('No results found') }}</td>
            </tr>
        </table>
    </div>
{% else %}
    {# Emitted before the table: the legacy code placed one <script> per row directly
       inside <table>, where the parser hoists it out anyway. #}
    {{ scripts_html|raw }}

    <div class="center first-bloc left">
        {% if canedit %}
            {{ open_form_html|raw }}
            {{ ma_top_html|raw }}
        {% endif %}

        <table class="tab_cadre_fixe">
            <tr class="tab_bg_2">
                <th class="center b" colspan="6">{{ title }}</th>
            </tr>
            <tr class="tab_bg_2">
                <th width="10">
                    {%- if canedit %}{{ check_all_html|raw }}{% endif -%}
                </th>
                <th>{{ __('Name') }}</th>
                <th>{{ __('Value') }}</th>
            </tr>
            {% for row in rows %}
                <tr class="tab_bg_1">
                    <td width="10">
                        {%- if canedit %}{{ row.checkbox_html|raw }}{% endif -%}
                    </td>
                    <td>
                        {% if canedit %}
                            <a href="javascript:{{ row.edit_function }}();">{{ row.label }}</a>
                        {% else %}
                            {{ row.label }}
                        {% endif %}
                        {{ row.mandatory_mark|raw }}
                    </td>
                    <td>{{ row.value_html|raw }}</td>
                </tr>
            {% endfor %}
        </table>

        {% if canedit %}
            {{ ma_bottom_html|raw }}
            {# closes the massive actions <form> above and carries the CSRF token #}
            {{ close_form_html|raw }}
        {% endif %}
    </div>
{% endif %}
