{#
 # Fields of the parent ticket (TicketField): one line per field, its value on the right.
 # A whole line opens the field in edit_target (public/scripts/wizard_form.js), but its
 # massive action checkbox (data-md-subitem-noopen).
 #}
{% if not has_rows %}
    <div class="card">
        <div class="card-body text-center text-muted py-5">
            <i class="ti ti-filter-down fs-1 d-block mb-2"></i>
            {{ __('No results found') }}
        </div>
    </div>
{% else %}
    {% if canedit %}
        {# raw: massive actions, no core macro #}
        {{ call('Html::getOpenMassiveActionsForm', [container])|raw }}
        {# raw: massive actions, no core macro #}
        {{ call('Html::showMassiveActions', [{
            'item': itemtype,
            'container': container,
            'display': false
        }])|raw }}
    {% endif %}

    <div class="card">
        <div class="card-header py-2 d-flex align-items-center gap-2">
            {% if canedit %}
                {# raw: massive actions, no core macro #}
                {{ call('Html::getCheckAllAsCheckbox', [container])|raw }}
            {% endif %}
            <h3 class="card-title m-0">{{ title }}</h3>
            <span class="badge bg-secondary-lt">{{ rows|length }}</span>
        </div>
        <div class="list-group list-group-flush">
            {% for row in rows %}
                <div class="list-group-item d-flex align-items-center gap-3{{ canedit ? ' list-group-item-action pointer' : '' }}"
                     {% if canedit %}
                         data-md-subitem-target="{{ edit_target }}"
                         data-md-subitem-url="{{ edit_url }}"
                         data-md-subitem-params="{{ row.edit_params|json_encode }}"
                     {% endif %}>
                    {% if canedit %}
                        <div data-md-subitem-noopen>
                            {# raw: massive actions, no core macro #}
                            {{ call('Html::getMassiveActionCheckBox', [itemtype, row.id])|raw }}
                        </div>
                    {% endif %}
                    <div class="fw-semibold text-nowrap">
                        {{ row.label }}
                        {% if row.is_mandatory %}
                            <span class="badge bg-red-lt ms-1" title="{{ __('Mandatory field') }}">*</span>
                        {% endif %}
                    </div>
                    {# getValueToDisplay() markup (links, line breaks), sanitized by the core #}
                    <div class="ms-auto text-end text-break">
                        {% if row.value_html|striptags|trim is not empty %}
                            {{ row.value_html|safe_html }}
                        {% else %}
                            <span class="text-muted">—</span>
                        {% endif %}
                    </div>
                    {% if canedit %}
                        <i class="ti ti-chevron-right text-muted"></i>
                    {% endif %}
                </div>
            {% endfor %}
        </div>
    </div>

    {% if canedit %}
        {# Rendered after the rows on purpose: when it is not the top one, showMassiveActions()
         # empties the selection that the row checkboxes read to restore their checked state #}
        {# raw: massive actions, no core macro #}
        {{ call('Html::showMassiveActions', [{
            'item': itemtype,
            'container': container,
            'ontop': false,
            'display': false
        }])|raw }}
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        </form>
    {% endif %}
{% endif %}
