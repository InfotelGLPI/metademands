{% if not has_rows %}
    <div class="center first-bloc">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <td class="center">{{ __('No results found') }}</td>
            </tr>
        </table>
    </div>
{% else %}
    <div class="center first-bloc left">
        {% if canedit %}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::getOpenMassiveActionsForm', [container])|raw }}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::showMassiveActions', [{
                'item': itemtype,
                'container': container,
                'display': false
            }])|raw }}
        {% endif %}

        <table class="tab_cadre_fixe">
            <tr class="tab_bg_2">
                <th class="center b" colspan="6">{{ title }}</th>
            </tr>
            <tr class="tab_bg_2">
                <th width="10">
                    {% if canedit %}
                        {# raw: massive actions, no core macro (§3.2) #}
                        {{ call('Html::getCheckAllAsCheckbox', [container])|raw }}
                    {% endif %}
                </th>
                <th>{{ __('Name') }}</th>
                <th>{{ __('Value') }}</th>
            </tr>
            {% for row in rows %}
                <tr class="tab_bg_1">
                    <td width="10">
                        {% if canedit %}
                            {# raw: massive actions, no core macro (§3.2) #}
                            {{ call('Html::getMassiveActionCheckBox', [itemtype, row.id])|raw }}
                        {% endif %}
                    </td>
                    <td>
                        {% if canedit %}
                            {# Loaded into edit_target by public/scripts/wizard_form.js. #}
                            <a href="#" data-md-subitem-target="{{ edit_target }}" data-md-subitem-url="{{ edit_url }}"
                               data-md-subitem-params="{{ row.edit_params|json_encode }}">{{ row.label }}</a>
                        {% else %}
                            {{ row.label }}
                        {% endif %}
                        {% if row.is_mandatory %}<span class="required">*</span>{% endif %}
                    </td>
                    {# getValueToDisplay() markup (links, line breaks), sanitized by the core (§3.1) #}
                    <td>{{ row.value_html|safe_html }}</td>
                </tr>
            {% endfor %}
        </table>

        {% if canedit %}
            {# Rendered after the rows on purpose: when it is not the top one, showMassiveActions()
             # empties the selection that the row checkboxes read to restore their checked state #}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::showMassiveActions', [{
                'item': itemtype,
                'container': container,
                'ontop': false,
                'display': false
            }])|raw }}
            </form>
        {% endif %}
    </div>
{% endif %}
