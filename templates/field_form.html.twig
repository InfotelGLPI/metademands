{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}

{#- A row of the custom values typed in the new field form -#}
{% macro new_value_row(index, value) %}
    <div class="input-group mb-1 md-new-value" data-md-new-value>
        <input type="text" class="form-control" name="_custom_values[{{ index }}][name]"
               value="{{ value.name ?? '' }}" data-md-new-value-name
               placeholder="{{ __('Value', 'metademands') }}" aria-label="{{ __('Value', 'metademands') }}">
        <label class="input-group-text gap-2" title="{{ __('Default value', 'metademands') }}">
            <input type="checkbox" class="form-check-input m-0" name="_custom_values[{{ index }}][is_default]"
                   value="1" data-md-new-value-default{{ (value.is_default ?? false) ? ' checked' }}>
            <span class="d-none d-md-inline">{{ __('Default value', 'metademands') }}</span>
        </label>
        <button type="button" class="btn btn-icon" data-md-new-value-remove
                title="{{ _x('button', 'Delete permanently') }}" aria-label="{{ _x('button', 'Delete permanently') }}">
            <i class="ti ti-x"></i>
        </button>
    </div>
{% endmacro %}

{#-
 # Form of a field of a metademand (Field::showForm()).
 #
 # Expected context, besides the plain values of the field:
 #  - type_options:    choices of the "Type" dropdown, or null when the type is fixed
 #                     (type_name is then displayed instead)
 #  - type_rand:       rand of the "Type" dropdown, listened to by the object selector
 #  - ajax_url, params_type, params_item: Ajax reloads driven by the "Type" dropdown
 #  - rank, rank_choices, rank_rand: "Block" dropdown, its blocks named by their title
 #  - titled_blocks:   [{rank, title}] of the blocks that already have a title (new field)
 #  - text_hints:      Field::getTextHints(), what the additional label and the comments become
 #  - item_selector:   options of the object selector, or null
 #  - item_fixed:      fixed object (item_fixed_name is displayed), or null
 #  - order:           {select, value} of the "Display field after" dropdown
-#}

{% do call('Html::requireJs', ['tinymce']) %}

{#- A new field is added in two steps: its type is chosen among cards grouped by family, then
 # its settings are shown (public/scripts/field_type_picker.js). The cards drive the "type"
 # dropdown, kept hidden, whose change still reloads the object selector. -#}
{% set picking_type = is_new and type is empty %}
{#- data-md-text-hints: what the additional label and the comments become, by type;
 # data-md-titled-blocks: the blocks that already have a title (field_type_picker.js) -#}
<form name="form" method="post" action="{{ action }}" data-md-field-form
      data-md-text-hints="{{ text_hints|json_encode }}"
      {% if is_new %}
          data-md-titled-blocks="{{ titled_blocks|json_encode }}"
          data-md-titled-message="{{ __('Block %1$s already has a block title: %2$s', 'metademands') }}"
      {% endif %}>
    {{ inputs.hidden('plugin_metademands_metademands_id', metademand_id) }}
    {% if not is_new %}{{ inputs.hidden('id', field_id) }}{% endif %}
    {#- One title per block (Field::prepareInputForAdd()) #}
    {% if is_new %}{{ inputs.hidden('_unique_block_title', 1) }}{% endif %}
    {{ inputs.hidden('entities_id', entities_id) }}
    {{ inputs.hidden('is_recursive', is_recursive) }}
    {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}

    {% if metafield_itil_warning %}
        <div class="alert alert-warning d-flex align-items-center mb-3">
            <i class="ti ti-alert-triangle me-2" style="font-size:2em;color:orange;"></i>
            <span>{{ __('Please add a type category field', 'metademands') }}</span>
        </div>
    {% endif %}

    <div class="card mt-2">
        <div class="card-body">

            {% if is_new %}
                {# Step 1: the type #}
                <div class="md-type-picker" data-md-type-picker{{ picking_type ? '' : ' hidden' }}>
                    <div class="input-icon mb-3">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="search" class="form-control" data-md-type-search
                               placeholder="{{ __('Search a type (text, date, list…)', 'metademands') }}"
                               aria-label="{{ __('Search a type (text, date, list…)', 'metademands') }}">
                    </div>
                    {% for group in type_groups %}
                        <div class="md-type-group md-type-family-{{ group.key }}" data-md-type-group>
                            <div class="md-type-group-title">{{ group.label }}</div>
                            <div class="md-type-grid">
                                {% for type_card in group.types %}
                                    <button type="button" class="md-type-card"
                                            data-md-type-card="{{ type_card.type }}"
                                            data-md-type-family="{{ group.key }}"
                                            data-md-type-icon="{{ type_card.icon }}"
                                            data-md-type-name="{{ type_card.name }}">
                                        <span class="md-type-icon"><i class="ti {{ type_card.icon }}"></i></span>
                                        <span class="md-type-text">
                                            <span class="md-type-name">{{ type_card.name }}</span>
                                            {% if type_card.description is not empty %}
                                                <span class="md-type-desc">{{ type_card.description }}</span>
                                            {% endif %}
                                            {% if type_card.type == 'title-block' %}
                                                <span class="md-type-desc md-type-taken" data-md-type-taken hidden>
                                                    <i class="ti ti-alert-triangle me-1"></i>{{ __('This block already has a title', 'metademands') }}
                                                </span>
                                            {% endif %}
                                        </span>
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                    {% endfor %}
                    <div class="text-muted text-center py-3" data-md-type-none hidden>{{ __('No type matches the search', 'metademands') }}</div>
                </div>
            {% endif %}

            {# Step 2 of a new field, or the form of an existing one #}
            <div data-md-field-settings{{ picking_type ? ' hidden' : '' }}>

            {% if is_new %}
                <div class="md-type-chosen md-type-family-{{ type_family }}">
                    <span class="md-type-icon" data-md-type-chosen-icon><i class="ti {{ type_icon }}"></i></span>
                    <div class="flex-fill">
                        <div class="text-muted small">{{ __('Type') }}</div>
                        <b data-md-type-chosen-name>{{ type_chosen_name }}</b>
                    </div>
                    <button type="button" class="btn btn-ghost-primary btn-sm" data-md-type-change>
                        <i class="ti ti-arrow-left me-1"></i>{{ __('Change the type', 'metademands') }}
                    </button>
                    {# The type the cards set: its change reloads the object selector #}
                    <span class="d-none">
                        {% do call('Dropdown::showFromArray', ['type', type_options, {'value': type, 'rand': type_rand}]) %}
                        {% do call('Ajax::updateItemOnSelectEvent', ['dropdown_type' ~ type_rand, 'show_values', ajax_url, params_type]) %}
                    </span>
                </div>
                {# A new field is active #}
                {{ inputs.hidden('is_active', 1) }}
            {% else %}
            {# Active / inactive, saved with the form: an inactive field is left out of the
               wizard, the ticket and the PDF (the indicator follows the switch, see
               .md-active-switch in metademands.css) #}
            <div class="row mb-3">
                <label class="col-4 col-form-label fw-bold" for="md-field-is-active">{{ __('Active') }}</label>
                <div class="col-8">
                    <label class="form-check form-switch mt-2 mb-0 md-active-switch">
                        <input type="hidden" name="is_active" value="0">
                        <input type="checkbox" class="form-check-input" id="md-field-is-active"
                               name="is_active" value="1"{{ is_active ? ' checked' }}>
                        <span class="form-check-label md-active-on">
                            <span class="badge bg-green-lt"><i class="ti ti-eye me-1"></i>{{ __('Active') }}</span>
                        </span>
                        <span class="form-check-label md-active-off">
                            <span class="badge bg-secondary-lt text-secondary"><i class="ti ti-eye-off me-1"></i>{{ __('Inactive') }}</span>
                        </span>
                    </label>
                    <div class="form-text">
                        {{ __('An inactive field is left out of the wizard, the ticket and the PDF, and its options have no effect', 'metademands') }}
                    </div>
                </div>
            </div>
            {% endif %}

            {# Libellé #}
            <div class="row mb-3">
                <label class="col-4 col-form-label fw-bold">
                    {{ __('Label') }} <span class="text-danger">*</span>
                </label>
                <div class="col-8">
                    <input type="text" name="name" class="form-control" value="{{ item_name }}">
                </div>
            </div>

            {# Libellé 2 + Commentaire: folded for a new field, unfolded by
               field_type_picker.js for the intervals, whose additional label is mandatory #}
            {% if is_new %}<details class="md-field-more mb-3" data-md-field-more{{ show_label2_required or label2 is not empty or comment is not empty ? ' open' : '' }}>
                <summary class="fw-bold">{{ __('Additional label and comments', 'metademands') }}</summary>{% endif %}
            <div class="row mb-3{{ is_new ? ' mt-2' : '' }}">
                <div class="col-6">
                    <label class="form-label fw-bold mb-0">
                        {{ __('Additional label', 'metademands') }}
                        <span id="show_label2"
                              class="text-danger"{{ not show_label2_required ? ' style="display:none;"' }}>*</span>
                    </label>
                    <div class="form-text mt-0 mb-1" data-md-text-hint="label2">{{ (text_hints[type] ?? text_hints['']).label2 }}</div>
                    {% do call('Html::textarea', [{'name': 'label2', 'value': label2,
                        'enable_richtext': true, 'enable_fileupload': false,
                        'enable_images': true, 'cols': 50, 'rows': 3}]) %}
                </div>
                <div class="col-6">
                    <label class="form-label fw-bold mb-0">{{ __('Comments') }}</label>
                    <div class="form-text mt-0 mb-1" data-md-text-hint="comment">{{ (text_hints[type] ?? text_hints['']).comment }}</div>
                    {% do call('Html::textarea', [{'name': 'comment', 'value': comment,
                        'enable_richtext': true, 'enable_fileupload': false,
                        'enable_images': true, 'cols': 50, 'rows': 3}]) %}
                </div>
            </div>
            {% if is_new %}</details>{% endif %}

            {# Type + Bloc; for a new field, whose type is shown above: Bloc + Mandatory #}
            <div class="row mb-3">
                {% if is_new %}
                    {# Not for the titles and the informations, which are never mandatory #}
                    <div class="col-6 order-2" data-md-field-mandatory>
                        <label class="form-label fw-bold" for="md-field-mandatory">{{ __('Mandatory field') }}</label>
                        <label class="form-check form-switch mt-1 mb-0">
                            <input type="hidden" name="_is_mandatory" value="0">
                            <input type="checkbox" class="form-check-input" id="md-field-mandatory"
                                   name="_is_mandatory" value="1"{{ is_mandatory_new ? ' checked' }}>
                        </label>
                    </div>
                    {% if basket_warning %}
                        <div class="col-12 order-3">
                            <div class="alert alert-warning d-flex mt-1">
                                <span>{{ __("Remember to activate basket mode on your metademand !", 'metademands') }}</span>
                            </div>
                        </div>
                    {% endif %}
                {% else %}
                <div class="col-6">
                    <label class="form-label fw-bold">
                        {{ __('Type') }} <span class="text-danger">*</span>
                    </label>
                    {% if type_options is not null %}
                        {% do call('Dropdown::showFromArray', ['type', type_options, {'value': type, 'rand': type_rand}]) %}
                        {% do call('Ajax::updateItemOnSelectEvent', ['dropdown_type' ~ type_rand, 'show_values', ajax_url, params_type]) %}
                    {% else %}
                        {{ type_name }}
                        <input type="hidden" name="type" value="{{ type }}">
                    {% endif %}
                    {% if basket_warning %}
                        <div class="alert alert-warning d-flex mt-1">
                            <span>{{ __("Remember to activate basket mode on your metademand !", 'metademands') }}</span>
                        </div>
                    {% endif %}
                </div>
                {% endif %}
                <div class="col-6{{ is_new ? ' order-1' : '' }}">
                    <label class="form-label fw-bold">{{ __('Block', 'metademands') }}</label>
                    {#- Every block in the page, named by its title: field_type_picker.js leaves
                     # out the titled ones for a new block title -#}
                    {% do call('Dropdown::showFromArray', ['rank', rank_choices, {'value': rank, 'rand': rank_rand}]) %}
                    {% do call('Ajax::updateItemOnSelectEvent', [
                        'dropdown_rank' ~ rank_rand,
                        'show_order',
                        plugin_web_dir ~ '/ajax/viewtypefields.php?id=' ~ field_id,
                        {'rank': '__VALUE__', 'step': 'order', 'fields_id': field_id,
                            'metademands_id': metademand_id, 'previous_fields_id': prev_fields_id}
                    ]) %}
                    {% if is_new %}
                        {# A block title in a block that already has one (field_type_picker.js) #}
                        <div class="alert alert-warning d-flex align-items-start gap-2 py-2 mt-2 mb-0" data-md-titled-warning hidden>
                            <i class="ti ti-alert-triangle mt-1"></i><span data-md-titled-warning-text></span>
                        </div>
                    {% endif %}
                </div>
            </div>

            {# Objet + Ordre #}
            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label fw-bold">
                        {%- if not is_new -%}
                            {{ __('Object', 'metademands') }}
                        {%- endif -%}
                    </label>
                    {% if item_selector is not null %}
                        {% include '@metademands/forms/field_item_selector.html.twig' with {
                            'type': type,
                            'dropdown_options': item_selector,
                            'type_rand': type_rand,
                            'ajax_url': ajax_url,
                            'params_item': params_item,
                        } only %}
                    {% elseif item_fixed is not null %}
                        {{ item_fixed_name }}
                        <input type="hidden" name="item" value="{{ item_fixed }}">
                    {% endif %}
                </div>
                {% if not is_title_block %}
                    <div class="col-6">
                        <label class="form-label fw-bold">{{ __('Display field after', 'metademands') }}</label>
                        <span id="show_order">{% do call('Dropdown::showFromArray', ['plugin_metademands_fields_id', order.select, {'value': order.value}]) %}</span>
                    </div>
                {% endif %}
            </div>

            {% if customvalues_warning %}
                <div class="alert alert-warning d-flex mt-2">
                    <b>{{ __('Warning : there is no custom values for this object', 'metademands') }}</b>
                </div>
            {% endif %}

            {% if is_new %}
                {#- The custom values of a checkbox, a radio button or a specific dropdown, typed
                 # at once (FieldCustomvalue::addInitialValues()); disabled, so not posted, for
                 # the other types (public/scripts/field_type_picker.js) -#}
                {% set initial_values = new_custom_values is not empty ? new_custom_values : [{}] %}
                <fieldset class="md-new-values mb-3" data-md-new-values
                          data-md-new-values-next="{{ initial_values|length }}"{{ new_values_shown ? '' : ' hidden disabled' }}>
                    <legend class="form-label fw-bold mb-1">{{ __('Custom values', 'metademands') }}</legend>
                    <div class="form-text mt-0 mb-2">
                        {{ __('Enter adds a value, a pasted list gives one value per line. They can be changed afterwards.', 'metademands') }}
                    </div>
                    <div data-md-new-values-list>
                        {% for value in initial_values %}
                            {{ _self.new_value_row(loop.index0, value) }}
                        {% endfor %}
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary mt-1" data-md-new-value-add>
                        <i class="ti ti-plus me-1"></i>{{ __('Add a value', 'metademands') }}
                    </button>
                    <template data-md-new-value-template>{{ _self.new_value_row('__INDEX__', {}) }}</template>
                </fieldset>
            {% endif %}

            <div id="show_values"></div>

            </div>{# data-md-field-settings #}

        </div>
        <div class="card-footer md-field-footer" data-md-field-settings{{ picking_type ? ' hidden' : '' }}>
            {% if is_new %}
                <button class="btn btn-secondary" type="submit" name="add_another" value="1">
                    <i class="ti ti-plus"></i>
                    <span>{{ __('Add and create another', 'metademands') }}</span>
                </button>
                <button class="btn btn-primary" type="submit" name="add" value="1">
                    <i class="ti ti-device-floppy"></i>
                    <span>{{ __('Add and close', 'metademands') }}</span>
                </button>
            {% else %}
                <button class="btn btn-primary" type="submit" name="update" value="1">
                    <i class="ti ti-device-floppy"></i>
                    <span>{{ _x('button', 'Save') }}</span>
                </button>
                {% if can_delete %}
                    <button class="btn btn-danger" type="submit" name="purge" value="1"
                            data-metademands-confirm="{{ __('Are you sure you want to delete this item?') }}">
                        <i class="ti ti-trash"></i>
                        <span>{{ _x('button', 'Delete permanently') }}</span>
                    </button>
                {% endif %}
            {% endif %}
        </div>
    </div>
</form>
