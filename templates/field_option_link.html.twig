{#-
 # Emits <tr> rows only: the caller renders this inside an already open <table>.
 #
 # Expected context:
 #  - blocks: rows built by FieldOption::showLinkHtml(), of three kinds:
 #     - row:    label, comment, alert_lines, widget_alert, widgets and widget_span;
 #               each widget is a GLPI helper printing itself, {callable, args}
 #     - hidden: name and value of a hidden input
 #     - raw:    html, the options a plugin prints (showOptions() hook)
-#}
{% for block in blocks %}
    {% if block.kind == 'hidden' %}
        <input type="hidden" name="{{ block.name }}" value="{{ block.value }}">
    {% elseif block.kind == 'raw' %}
        {# raw: markup returned by the showOptions() hook of a third-party plugin, not ours to escape (§3.2) #}
        {{ block.html|raw }}
    {% else %}
        <tr>
            <td colspan="2">
                {{ block.label }}
                <br>
                <span class="alert alert-danger metademands_wizard_comments">{{ block.comment }}</span>
                {% if block.alert_lines is not empty %}
                    <div class="alert alert-danger">
                        {%- for line in block.alert_lines -%}
                            {{ line }}{% if not loop.last %}<br>{% endif %}
                        {%- endfor -%}
                    </div>
                {% endif %}
            </td>
            <td>
                {% if block.widget_alert %}
                    <span class="alert alert-warning d-flex">{{ block.widget_alert }}</span>
                {% endif %}
                {% for widget in block.widgets %}
                    {% do call(widget.callable, widget.args) %}
                {% endfor %}
                {% if block.widget_span is not null %}
                    <span id="{{ block.widget_span.id }}">{% do call(block.widget_span.widget.callable, block.widget_span.widget.args) %}</span>
                {% endif %}
            </td>
        </tr>
    {% endif %}
{% endfor %}
