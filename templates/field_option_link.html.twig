{# Emits <tr> rows only: the caller renders this inside an already open <table>. #}
{% for block in blocks %}
    {% if block.kind == 'raw' %}
        {{ block.html|raw }}
    {% else %}
        <tr>
            <td colspan="2">
                {{ block.label }}
                <br>
                <span class="alert alert-danger metademands_wizard_comments">{{ block.comment }}</span>
                {% if block.alert_lines is not empty %}
                    <div class="alert alert-danger">
                        {%- for line in block.alert_lines -%}
                            {{ line }}{% if not loop.last %}<br>{% endif %}
                        {%- endfor -%}
                    </div>
                {% endif %}
            </td>
            <td>
                {% if block.widget_alert %}
                    <span class="alert alert-warning d-flex">{{ block.widget_alert }}</span>
                {% endif %}
                {{ block.widget_html|raw }}
                {% if block.widget_span is not null %}
                    <span id="{{ block.widget_span.id }}">{{ block.widget_span.html|raw }}</span>
                {% endif %}
            </td>
        </tr>
    {% endif %}
{% endfor %}
