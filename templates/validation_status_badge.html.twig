{#-
 # Validation status of a meta-demand, as displayed by the search engine
 # (MetademandValidation::getSpecificValueToDisplay(), search option 9501).
 #
 # Expected context:
 #  - label: status name
 #  - color: badge color suffix (orange, green), empty for a plain label
-#}
{%- if color is not empty -%}
    <span class="badge bg-{{ color }}-lt">{{ label }}</span>
{%- else -%}
    {{ label }}
{%- endif -%}
