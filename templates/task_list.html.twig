{#
 # The add button and the rows of the basic tasks load the task form into
 # viewchild_id: data-md-subitem-* attributes, read by public/scripts/wizard_form.js.
 # The cells marked data-md-subitem-noopen do not open it.
 #}
{% if canedit and solved %}
    <div id="{{ viewchild_id }}"></div>

    <div class="center">
        <button type="button" class="submit btn btn-primary"
                data-md-subitem-target="{{ viewchild_id }}"
                data-md-subitem-url="{{ viewsubitem_url }}"
                data-md-subitem-params="{{ add_params|json_encode }}">
            {{ __('Add a task', 'metademands') }}
        </button>
    </div>
    <br>
{% endif %}

<div class="center first-bloc">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1 center">
            <td>
                <a href="#" class="submit btn btn-primary" data-bs-toggle="modal"
                   data-bs-target="#tags" title="{{ __('Show list of available tags') }}">
                    {{ __('Show list of available tags') }}
                </a>
                {# Iframe modal, no core macro: printed directly, as core templates do (§3.2). #}
                {% do call('Ajax::createIframeModalWindow', ['tags', tags_url, {
                    'title': __('Show list of available tags'),
                }]) %}
            </td>
        </tr>
    </table>
</div>

{% if entries|length > 0 %}
    <script src="{{ js_path('/plugins/metademands/lib/treetable/treetable.js') }}"></script>

    <div class="left first-bloc">
        {% if canedit and solved %}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::getOpenMassiveActionsForm', [mass_container])|raw }}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::showMassiveActions', [{
                'item': itemtype,
                'container': mass_container,
                'display': false
            }])|raw }}
        {% endif %}

        <table id="tree-table" class="tab_cadre_fixehov">
            <tr class="tab_bg_2">
                <th class="left b" colspan="12">{{ __('Tasks', 'metademands') }}</th>
            </tr>
            <tr class="tab_bg_2">
                <th width="10">
                    {% if canedit and solved %}
                        {# raw: massive actions, no core macro (§3.2) #}
                        {{ call('Html::getCheckAllAsCheckbox', [mass_container])|raw }}
                    {% endif %}
                </th>
                <th class="center b" width="6%">{{ __('ID') }}</th>
                <th class="center b">{{ __('Name') }}</th>
                <th class="center b">{{ __('Entity') }}</th>
                <th class="center b">{{ __('Type') }}</th>
                <th class="center b">{{ __('Category') }}</th>
                <th class="center b">{{ __('Assigned to') }}</th>
                <th class="center b">{{ __('Level', 'metademands') }}</th>
                <th class="center b">{{ __('Block to use', 'metademands') }}</th>
                <th class="center b">{{ __('Use block', 'metademands') }}</th>
                <th class="center b">{{ __('Format the description of the childs ticket as a table', 'metademands') }}</th>
                <th class="center b">{{ __('Block parent ticket resolution', 'metademands') }}</th>
            </tr>

            {% for entry in entries %}
                {% set onhover = entry.edit_params is not empty %}
                {# Cells opening the task form carry the pointer, the others their meta class #}
                {% set cell_class = onhover ? 'pointer' : entry.td_class %}
                <tr class="tab_bg_1 {{ entry.row_class }}"
                    {% if entry.row_style is not empty %}style="{{ entry.row_style }}"{% endif %}
                    data-id="{{ entry.id }}" data-parent="{{ entry.parent }}" data-level="{{ entry.level }}"
                    {% if onhover %}
                        data-md-subitem-target="{{ viewchild_id }}"
                        data-md-subitem-url="{{ viewsubitem_url }}"
                        data-md-subitem-params="{{ entry.edit_params|json_encode }}"
                    {% endif %}>

                    {# Massive action checkbox #}
                    <td {% if entry.td_class is not empty %}class="{{ entry.td_class }}"{% endif %} width="10" data-md-subitem-noopen>
                        {% if canedit and solved %}
                            {# raw: massive actions, no core macro (§3.2) #}
                            {{ call('Html::getMassiveActionCheckBox', [itemtype, entry.id])|raw }}
                        {% endif %}
                    </td>

                    {# ID (name column anchor for treetable, which adds the expander) #}
                    <td data-column="name" data-md-subitem-noopen>{{ entry.id }}</td>

                    {# Name #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {% if entry.name_url is not empty %}
                            <a href="{{ entry.name_url }}">{{ entry.name }}</a>
                        {% else %}
                            {{ entry.name }}
                        {% endif %}
                    </td>

                    {# Entity #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {{ entry.entity }}
                    </td>

                    {# Type #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {{ entry.type }}
                    </td>

                    {# Category #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {{ entry.category }}
                    </td>

                    {# Assigned to #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {% for line in entry.assign %}
                            {{ line }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                    </td>

                    {# Level #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        <div class="center">{{ entry.level_label }}</div>
                    </td>

                    {# Block to use #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {% for label in entry.block %}
                            {{ label }}{% if not loop.last %}<br>{% endif %}
                        {% endfor %}
                    </td>

                    {# Use block #}
                    <td {% if entry.td_class is not empty %}class="{{ entry.td_class }}"{% endif %} data-md-subitem-noopen>
                        {{ entry.useblock }}
                    </td>

                    {# Format description as table #}
                    <td {% if cell_class is not empty %}class="{{ cell_class }}"{% endif %}>
                        {{ entry.formatastable }}
                    </td>

                    {# Block parent ticket resolution #}
                    <td {% if entry.td_class is not empty %}class="{{ entry.td_class }}"{% endif %} data-md-subitem-noopen>
                        {{ entry.block_parent }}
                    </td>
                </tr>
            {% endfor %}
        </table>

        {% if canedit and solved %}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::showMassiveActions', [{
                'item': itemtype,
                'container': mass_container,
                'ontop': false,
                'display': false
            }])|raw }}
            </form>
        {% endif %}
    </div>
{% else %}
    <div class="center first-bloc">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1"><td class="center">{{ __('No results found') }}</td></tr>
        </table>
    </div>
{% endif %}
