{#-
 # Section of a son ticket content (§4.8 of docs/TWIG_MIGRATION.md): the
 # content of the son ticket, or the content reported from its parent. The
 # output is stored in the ticket and sent by notifications, so it keeps inline
 # styles and stays on a single line.
 #
 # @param string title         plain text, shown when framed
 # @param string content       rich text, sanitized here
 # @param bool   framed        in a titled table, or the content only
 # @param string table_class   'tab_cadre' (created tickets) or 'tab_cadre_fixe'
 #}
{%- if framed -%}
    {%- if table_class == 'tab_cadre_fixe' -%}
        <table class="tab_cadre_fixe" style="width: 100%;">
    {%- else -%}
        <table class="tab_cadre" style="width: 100%;border:0;background:none;word-break: unset;">
    {%- endif -%}
    <tr><th colspan="2">{{ title }}</th></tr><tr><td colspan="2">{{ content|safe_html }}</td></tr></table><br>
{%- else -%}
    {{ content|safe_html }}
{%- endif -%}
