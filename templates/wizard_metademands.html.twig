{#- Step of the wizard (Wizard::showMetademands()).
 #
 #  - forms: form of the step, assembled by the legacy Wizard::constructForm() chain
 #  - show_actions, actions_margin, show_print: flags of the bottom actions
 #  - ancestor_tickets_id: parent ticket of a sub-request, or null -#}
<div class="md-basket-wizard"></div>

<div class="md-wizard">
    {% if has_data %}
        {# raw: wizard form printed by the Field::getFieldInput() widgets (constructForm(), §3.2) #}
        {{ forms|raw }}

        {% if show_actions %}
            <div class="row" style="width: 100%;">
                <div class="bt-feature col-md-12"{% if actions_margin %} style="margin-top: 20px"{% endif %}>
                    <input type="hidden" name="metademands_id" value="{{ metademands_id }}">
                </div>
            </div>
        {% endif %}

        <input type="hidden" name="create_metademands" value="1">

        {% if ancestor_tickets_id is not null %}
            <input type="hidden" name="ancestor_tickets_id" value="{{ ancestor_tickets_id }}">
        {% endif %}

        {% if show_print %}
            <br>
            <a href="#" class="metademand_middle_button" onclick="window.print();return false;">
                <i style="font-size:2em;color:#e3e0e0;" class="ti ti-printer"></i>
            </a>
        {% endif %}
    {% endif %}
</div>

{% if not has_data %}
    <div class="center first-bloc">
        <div class="row">
            <div class="bt-feature col-md-12">{{ __('No results found') }}</div>
        </div>
        <div class="row">
            <div class="bt-feature col-md-12">
                <button type="submit" name="previous" value="{{ __('Previous') }}" class="btn btn-primary">
                    <span>{{ __('Previous') }}</span>
                </button>
                <input type="hidden" name="previous_metademands_id" value="{{ metademands_id }}">
            </div>
        </div>
    </div>
{% endif %}
