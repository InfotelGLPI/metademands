<div class="md-basket-wizard"></div>

<div class="md-wizard">
    {% if has_data %}
        {# Form fragment built by the legacy constructForm() chain #}
        {{ forms|raw }}

        {% if show_actions %}
            <div class="row" style="width: 100%;">
                <div class="bt-feature col-md-12"{% if actions_margin %} style="margin-top: 20px"{% endif %}>
                    {{ call('Html::hidden', ['metademands_id', {'value': metademands_id}])|raw }}
                </div>
            </div>
        {% endif %}

        {{ call('Html::hidden', ['create_metademands', {'value': 1}])|raw }}

        {% if ancestor_tickets_id is not null %}
            {{ call('Html::hidden', ['ancestor_tickets_id', {'value': ancestor_tickets_id}])|raw }}
        {% endif %}

        {% if show_print %}
            <br>
            <a href="#" class="metademand_middle_button" onclick="window.print();return false;">
                <i style="font-size:2em;color:#e3e0e0;" class="ti ti-printer"></i>
            </a>
        {% endif %}
    {% endif %}
</div>

{% if not has_data %}
    <div class="center first-bloc">
        <div class="row">
            <div class="bt-feature col-md-12">{{ __('No results found') }}</div>
        </div>
        <div class="row">
            <div class="bt-feature col-md-12">
                {{ call('Html::submit', [__('Previous'), {'name': 'previous', 'class': 'btn btn-primary'}])|raw }}
                {{ call('Html::hidden', ['previous_metademands_id', {'value': metademands_id}])|raw }}
            </div>
        </div>
    </div>
{% endif %}
