{#- Step of the wizard (Wizard::showMetademands()).
 #
 #  - forms: form of the step, assembled by the legacy Wizard::constructForm() chain
 #  - show_actions, actions_margin, show_print: flags of the bottom actions
 #  - ancestor_tickets_id: parent ticket of a sub-request, or null -#}
<div class="md-basket-wizard"></div>

{#- data-md-wizard-layout: read by public/scripts/wizard_layout.js, which adds the summary of
 #  the blocks (one page form), the stepper (step by step form) and the yes / no buttons.
 #  Its labels travel here, translated, so the script has no string of its own. -#}
<div class="md-wizard"
     {%- if enhanced_layout ?? false %}
         data-md-wizard-layout
         data-md-label-summary="{{ __('Summary', 'metademands') }}"
         data-md-label-block="{{ __('Block %s', 'metademands') }}"
         data-md-label-filled="{{ __('%1$s / %2$s mandatory fields filled', 'metademands') }}"
         data-md-label-left-one="{{ _n('%s left', '%s left', 1, 'metademands') }}"
         data-md-label-left-other="{{ _n('%s left', '%s left', 2, 'metademands') }}"
         data-md-label-complete="{{ __('Complete', 'metademands') }}"
         data-md-label-step="{{ __('Step %1$s of %2$s', 'metademands') }}"
         data-md-label-mandatory-one="{{ _n('%s mandatory', '%s mandatory', 1, 'metademands') }}"
         data-md-label-mandatory-other="{{ _n('%s mandatory', '%s mandatory', 2, 'metademands') }}"
         data-md-label-optional="{{ __('Optional', 'metademands') }}"
         data-md-label-sections-one="{{ _n('%s section', '%s sections', 1, 'metademands') }}"
         data-md-label-sections-other="{{ _n('%s section', '%s sections', 2, 'metademands') }}"
         data-md-label-conditions="{{ __('Your request does not meet the conditions to be sent', 'metademands') }}"
         {%- if can_send ?? false %} data-md-can-send{% endif %}
         {%- if use_conditions ?? false %}
             data-md-conditions
             data-md-conditions-url="{{ conditions_url }}"
             data-md-conditions-show-button="{{ conditions_show_button }}"
         {%- endif %}
     {%- endif %}>
    {% if has_data %}
        {# raw: wizard form printed by the Field::getFieldInput() widgets (constructForm(), §3.2) #}
        {{ forms|raw }}

        {% if show_actions %}
            <div class="row" style="width: 100%;">
                <div class="bt-feature col-md-12"{% if actions_margin %} style="margin-top: 20px"{% endif %}>
                    <input type="hidden" name="metademands_id" value="{{ metademands_id }}">
                </div>
            </div>
        {% endif %}

        <input type="hidden" name="create_metademands" value="1">

        {% if ancestor_tickets_id is not null %}
            <input type="hidden" name="ancestor_tickets_id" value="{{ ancestor_tickets_id }}">
        {% endif %}

        {% if show_print %}
            <br>
            <a href="#" class="metademand_middle_button" onclick="window.print();return false;">
                <i style="font-size:2em;color:#e3e0e0;" class="ti ti-printer"></i>
            </a>
        {% endif %}
    {% endif %}
</div>

{% if not has_data %}
    <div class="center first-bloc">
        <div class="row">
            <div class="bt-feature col-md-12">{{ __('No results found') }}</div>
        </div>
        <div class="row">
            <div class="bt-feature col-md-12">
                <button type="submit" name="previous" value="{{ __('Previous') }}" class="btn btn-primary">
                    <span>{{ __('Previous') }}</span>
                </button>
                <input type="hidden" name="previous_metademands_id" value="{{ metademands_id }}">
            </div>
        </div>
    </div>
{% endif %}
