{#- Navigation footer of the wizard: cancel form, previous/next buttons and the
 #  step circles of the non-tabbed mode.
 #
 #  Expected context:
 #    use_as_step        : whether the step-by-step mode is active (adds #nextMsg)
 #    draft_input_html   : Draft::createDraftInput() markup, empty when drafts are off
 #    cancel_form_html   : Html::showSimpleForm() markup, empty when not applicable
 #    show_step_circles  : whether the step circles must be rendered
 #    step_count         : number of steps, drives how many circles are drawn
-#}
<div class="form-sc-group">
    <div class="center">
        <div style="overflow:auto;margin-top:10px">
            {% if use_as_step == 1 %}
                <div id="nextMsg" class="alert alert-info center"></div>
            {% endif %}
            {{ draft_input_html|raw }}
            {% if cancel_form_html %}
                <span style="color:darkred;font-size: 14px !important;margin-right: 8px">{{ cancel_form_html|raw }}</span>
            {% endif %}
            <button type="button" id="prevBtn" style="margin-right: 8px;font-size: 14px !important;" class="btn btn-primary">
                <i class="ti ti-chevron-left"></i>&nbsp;{{ __('Previous', 'metademands') }}
            </button>
            &nbsp;<button type="button" id="nextBtn" style="margin-right: 8px;font-size: 14px !important;" class="btn btn-primary">
                {{ __('Next', 'metademands') }}&nbsp;<i class="ti ti-chevron-right"></i>
            </button>
            &nbsp;<button type="button" id="nextBtn2" style="margin-right: 8px;font-size: 14px !important;display: none" class="btn btn-primary">
                {{ __('Next', 'metademands') }}&nbsp;<i class="ti ti-chevron-right"></i>
            </button>
        </div>
    </div>
</div>

{% if show_step_circles %}
    {# Circles which indicate the steps of the form #}
    <div class="step_wizard_div center">
        {% if step_count > 1 %}
            {% for i in 1..step_count %}
                <span class="step_wizard"></span>
            {% endfor %}
        {% else %}
            <span class="step_wizard" style="display: none"></span>
        {% endif %}
    </div>
{% endif %}
