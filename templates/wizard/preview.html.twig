{#
 # Preview of a meta-demand wizard, shown in its administration tab.
 #
 # Expected context:
 #  - title:       heading of the card
 #  - wizard_html: markup still printed by Wizard::showWizard()
 #}

<div class="card mt-2">
    <div class="card-header">
        <h5 class="card-title">{{ title }}</h5>
    </div>

    <div class="card-body">
        {{ wizard_html|raw }}
    </div>
</div>
