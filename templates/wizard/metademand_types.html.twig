{% if entries|length > 0 %}
    {% for entry in entries %}
        <a class="bt-buttons" href="{{ entry.url }}">
            <div class="btnsc-normal-type" style="min-height: 190px;">
                <div class="center">
                    {% if entry.is_fa_icon %}
                        <i class="bt-interface fa-menu-md fas {{ entry.icon }} fa-5x"
                           style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands',serif;"></i>
                    {% else %}
                        <i class="bt-interface fa-menu-md ti {{ entry.icon }}" style="font-size:6em;"></i>
                    {% endif %}
                </div>
                <br>
                <p style="font-weight: normal;font-size: 13px;">
                    {{ entry.name }}
                    <br><em><span style="font-weight: normal;font-size: 11px;padding-left:5px"></span></em>
                </p>
            </div>
        </a>
    {% endfor %}
{% else %}
    <div class="alert alert-info center">
        {{ __('No existing forms founded', 'metademands') }}
    </div>
{% endif %}
