{#
 # Title card of a meta-demand, above its wizard.
 #
 # Expected context (built by Wizard::getMetademandTitleContext()):
 #  - illustration:         name of the illustration, drawn by render_illustration()
 #  - category_details_id:  service catalog category whose details open in a modal, 0 otherwise
 #  - category_details_url: page loaded in that modal
 #  - comment:              designer-defined rich HTML, sanitized by |safe_html
 #  - models_and_drafts:    context of models_and_drafts.html.twig, null when not displayed
 #  - requester:           {name, entity} of the connected requester, null when not displayed
 #}

{#- Title card: the visual of the metademand in a tile, its name and description, the
 #  requester on the right, then the drop-down of the models and drafts. -#}
<div class="md-title mb-3">
    <div class="card md-title-card" style="background-color: {{ background_color }}!important;">
        <div class="card-body d-flex flex-wrap flex-md-nowrap align-items-center gap-3">
            {% if illustration is not empty %}
                {# Held in its tile: no negative margin, which made it overflow the card #}
                <div class="md-title-visual md-title-illustration">
                    {{ render_illustration(illustration) }}
                </div>
            {% elseif icon is not empty %}
                <div class="md-title-visual">
                    {% if is_fa_icon %}
                        <i class="fas {{ icon }}"
                           style="{{ icon_color }};font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands',serif;"></i>
                    {% else %}
                        <i class="ti {{ icon }}" style="{{ icon_color }};"></i>
                    {% endif %}
                </div>
            {% endif %}
            <div class="md-title-text">
                <h2 class="md-title-name text-break"
                    {% if style_title_color is not empty %}style="color: {{ style_title_color }};"{% endif %}>
                    {{- title }}{{ cat_name -}}
                    {%- if category_completename is not empty %} - {{ category_completename }}{% endif -%}
                    {%- if category_details_id %}
                        &nbsp;<i class="ti ti-question-mark pointer"
                                 data-bs-toggle="modal"
                                 data-bs-target="#categorydetails{{ category_details_id }}"
                                 title="{{ __('More informations', 'servicecatalog') }}"></i>
                        {# Iframe modal, no core macro: printed directly, as core templates do (§3.2). #}
                        {% do call('Ajax::createIframeModalWindow', ['categorydetails' ~ category_details_id, category_details_url, {
                            'title': __('More informations', 'servicecatalog'),
                            'width': 1050,
                            'height': 500,
                        }]) %}
                    {% endif %}
                    {% if settings_url is not empty %}
                        &nbsp;<a href="{{ settings_url }}" title="{{ __('Setup') }}"><i class="ti ti-settings"></i></a>
                    {% endif %}
                </h2>
                {% if comment is not empty %}
                    <div class="md-title-comment text-secondary remove-last-tinymce-margin">
                        {{ comment|safe_html }}
                    </div>
                {% endif %}
            </div>
            {% if (requester ?? null) is not null %}
                <div class="md-title-requester small text-secondary">
                    <div>{{ __('Requester') }} : <span class="fw-medium text-body">{{ requester.name }}</span></div>
                    <div>{{ __('Entity') }} : <span class="fw-medium text-body">{{ requester.entity }}</span></div>
                </div>
            {% endif %}
            {% if models_and_drafts is not null %}
                {# Reference of the absolutely placed panel: it opens right under its toggle #}
                <div class="md-title-forms">
                    {% include '@metademands/wizard/models_and_drafts.html.twig' with models_and_drafts only %}
                </div>
            {% endif %}
        </div>
    </div>
</div>
