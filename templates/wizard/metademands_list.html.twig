{#
 # List of the meta-demands the requester can pick.
 #
 # Expected context:
 #  - display_cards: cards (entries, most_used) or a plain drop-down (metademands)
 #  - most_used:     entries of most_used_metademands.html.twig
 #  - entries:       cards; comment is designer-defined rich HTML, sanitized by |safe_html
 #  - metademands:   id => name of the drop-down
 #}

{% if display_cards %}
    <div id="listmeta">
        {% include '@metademands/wizard/most_used_metademands.html.twig' with {'entries': most_used} only %}
        <div tabindex="-1" id="mt-fuzzysearch">
            <div class="modal-content">
                <div class="modal-body" style="padding: 10px;">
                    <input type="text" class="mt-home-trigger-fuzzy form-control"
                           placeholder="{{ __('Find a form', 'metademands') }}">
                    <input type="hidden" name="meta_type" id="meta_type" value="{{ meta_type }}">
                    <ul class="results list-group mt-2" style="background: var(--tblr-bg-surface, #FFF);"></ul>
                </div>
            </div>
        </div>

        <div class="row">
            {% for entry in entries %}
                <div class="col-12 col-sm-6 col-md-4 d-flex">
                    <a class="card mx-1 my-2 flex-grow-1" title="{{ entry.tooltip }}" href="{{ entry.url }}">
                        <section class="card-body">
                            <div class="d-flex">
                                <div class="aspect-ratio-1"
                                     style="margin-left: 10px;width: 70px;height: 70px;">
                                    <span class="md-cat-icon-stack fa-2x">
                                        <i class="ti ti-circle" style="{{ entry.icon_color }};"></i>
                                        {% if entry.is_fa_icon %}
                                            <i class="fas {{ entry.icon }} fa-1x"
                                               style="{{ entry.icon_color }};font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands',serif;font-size: 1em;"></i>
                                        {% else %}
                                            <i class="ti {{ entry.icon }}"
                                               style="{{ entry.icon_color }};font-size: 1em;"></i>
                                        {% endif %}
                                    </span>
                                </div>
                                <div class="ms-4">
                                    <h2 class="card-title mb-2 text-break">{{ entry.name }}</h2>
                                    <div class="text-secondary remove-last-tinymce-margin"
                                         style="font-size:0.8rem;">
                                        {% if entry.comment is not empty %}
                                            {{ entry.comment|safe_html }}
                                        {% else %}
                                            {{ entry.name }}
                                        {% endif %}
                                        {% if entry.drafts_label is not empty %}
                                            <br><br><span style="{{ entry.icon_color }};">{{ entry.drafts_label }}</span>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </section>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
{% else %}
    <div id="listmeta" class="bt-row">
        <div class="bt-feature bt-col-sm-12 bt-col-md-12">
            {% do call('Dropdown::showFromArray', ['metademands_id', metademands, {'width': 250}]) %}
        </div>
    </div>
    <br>
    <div class="bt-row">
        <div class="bt-feature bt-col-sm-12 bt-col-md-12 right">
            <input type="hidden" name="step" value="{{ step_show }}">
            <input type="hidden" name="meta_type" id="meta_type" value="{{ meta_type }}">
            <button type="submit" name="next" value="{{ __('Next', 'metademands') }}" class="btn btn-primary">
                <span>{{ __('Next', 'metademands') }}</span>
            </button>
        </div>
    </div>
{% endif %}
