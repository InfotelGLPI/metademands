{#- Confirmation modal shown before submitting a wizard left empty.
 #  Wired by plugin_metademands_wizard_nextBtn() through #confirmYes / #confirmNo.
 #  #modalgroupspan is the anchor Step::showStep() loads its own modal into.
-#}
<span id="modalgroupspan"></span>

<div class="modal fade" id="confirmationModal" tabindex="-1" role="dialog" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">{{ __('Confirmation', 'metademands') }}</h5>
                <button type="button" class="close btn-close" data-bs-dismiss="modal" aria-label="{{ __('Close') }}"></button>
            </div>
            <div class="modal-body">
                {{ __('You have not entered any values. Is this normal?', 'metademands') }}
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" id="confirmNo" data-bs-dismiss="modal">{{ __('No') }}</button>
                <button type="button" class="btn btn-primary" id="confirmYes" data-bs-dismiss="modal">{{ __('Yes') }}</button>
            </div>
        </div>
    </div>
</div>
