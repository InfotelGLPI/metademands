{#- The meta-demands the requester used the most: shortcuts above the list of the forms -#}
{% if entries|length > 0 %}
    <div class="md-most-used d-flex flex-wrap align-items-center gap-2 mb-3">
        <i class="ti ti-history text-secondary" aria-hidden="true"></i>
        {% for entry in entries %}
            <a class="btn btn-sm md-most-used-item" href="{{ entry.url }}">
                {% if entry.is_fa_icon %}
                    <i class="fas {{ entry.icon }} me-1"
                       style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands',serif;"></i>
                {% else %}
                    <i class="ti {{ entry.icon }} me-1"></i>
                {% endif %}
                {{- entry.name -}}
            </a>
        {% endfor %}
    </div>
{% endif %}
