{#- Data the previous holder of a step-by-step form typed, replayed in a modal by
 #  public/scripts/wizard_form.js once the wizard is in the DOM.
 #
 #  Expected context:
 #    title      : dialog title
 #    user_label : "Previous user" label, empty when that user could not be loaded
 #    user_name  : display name of the previous user
 #    content    : already sanitised HTML of the parent fields
-#}
<div class="d-none" data-metademands-previous-dialog="{{ title }}">
    {% if user_label is not empty %}
        <table class="tab_cadre_fixe" style="width: 100%;">
            <tr class="even">
                <td class="title">{{ user_label }} : {{ user_name }}</td>
            </tr>
        </table>
    {% endif %}
    {{ content|raw }}
</div>
