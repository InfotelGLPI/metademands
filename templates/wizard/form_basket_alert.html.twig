{#- Basket reminder displayed above the wizard when the requester already owns
 #  lines in the basket of the current meta-demand.
 #
 #  Expected context:
 #    hidden_html   : Html::hidden('see_basket_summary') markup
 #    submit_html   : Html::submit() markup of the "See your basket" button (#submitjob)
 #    basket_url    : ajax/createmetademands.php endpoint, read by public/scripts/wizard_form.js
-#}
<div class="alert alert-warning d-flex" data-metademands-basket-url="{{ basket_url }}">
    <b>{{ __('You have items on your basket', 'metademands') }}</b>
    <div id="ajax_loader" class="ajax_loader hidden"></div>
    {{ hidden_html|raw }}
    {{ submit_html|raw }}
</div>
