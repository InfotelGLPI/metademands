{#
 # The closing tags are emitted conditionally at the very end of this template: the wizard is
 # rendered inside several host layouts (helpdesk page, service catalog, preview modal) which each
 # close a different number of wrappers themselves. Keeping the historical asymmetry avoids
 # breaking those layouts.
 #
 # Expected context (built by Wizard::showWizard()):
 #  - models_and_drafts: context of models_and_drafts.html.twig, null when not displayed here
 #  - breadcrumb:        context of wizard_breadcrumb.html.twig, null outside the service catalog
 #  - metademand_title:  context of metademand_title.html.twig, null when the title is hidden
 #  - abort:             '' (form displayed), 'silent' or 'message' (abort_message displayed)
 #  - steps:             markup still printed by Wizard::showWizardSteps()
 #  - back_url:          list of the forms: back to the choice of the type, '' when single
 #}
<div id="content">
<div id="meta-form" class="bt-block">
<form novalidate name="wizard_form" id="wizard_form"
      method="post"
      action="{{ form_action }}"
      enctype="multipart/form-data"
      class="metademands_img">

    {% if models_and_drafts is not null %}
        {% include '@metademands/wizard/models_and_drafts.html.twig' with models_and_drafts only %}
    {% endif %}

    {% if maintenance %}
        <div class="alert alert-warning center">
            <i class="ti ti-alert-triangle" style="font-size:2em;color:orange"></i>&nbsp;
            {{ __('This form is in maintenance mode', 'metademands') }}<br>
            {{ __('Please come back later', 'metademands') }}
        </div>
    {% else %}
        <div class="bt-container-fluid asset metademands_wizard_rank">

            {% if breadcrumb is not null %}
                {% include '@metademands/wizard/wizard_breadcrumb.html.twig' with breadcrumb only %}
            {% endif %}

            {% for name, value in hidden_fields %}
                <input type="hidden" name="{{ name }}" value="{{ value }}">
            {% endfor %}

            {% if header == 'init' or header == 'list' %}
                {#- Same title card as a form (metademand_title.html.twig): the icon in a tile,
                 #  the question, a way back to the types on the list of the forms -#}
                <div class="md-title mb-3">
                    <div class="card md-title-card">
                        <div class="card-body d-flex align-items-center gap-3">
                            {% if icon is not empty %}
                                <div class="md-title-visual">
                                    {% if is_fa_icon %}
                                        <i class="fas {{ icon }}"
                                           style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands',serif;"></i>
                                    {% else %}
                                        <i class="ti {{ icon }}"></i>
                                    {% endif %}
                                </div>
                            {% endif %}
                            <div class="md-title-text">
                                <h2 class="md-title-name">
                                    {%- if header == 'init' -%}
                                        {{ __('What you want to do ?', 'metademands') }}
                                    {%- else -%}
                                        {{ __('Form choice', 'metademands') }}
                                    {%- endif -%}
                                </h2>
                            </div>
                            {% if (back_url ?? '') is not empty %}
                                <a class="btn btn-ghost-secondary flex-none" href="{{ back_url }}">
                                    <i class="ti ti-arrow-left me-1"></i>{{ __('Previous', 'metademands') }}
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% elseif header == 'form' and metademand_title is not null %}
                {% include '@metademands/wizard/metademand_title.html.twig' with metademand_title only %}
            {% endif %}

            {% if abort == 'message' %}
                {% include '@metademands/wizard/message.html.twig' with {'message': abort_message, 'is_error': true} only %}
            {% elseif abort == '' %}
                {% if requester_id is not null %}
                    <input type="hidden" name="_users_id_requester" value="{{ requester_id }}">
                {% endif %}
                {# raw: steps of the form, printed by Wizard::showWizardSteps() around the Wizard::constructForm() step form (§3.2); captured because it may redirect, which call() would turn into a Twig error #}
                {{ steps|raw }}
                </form>
            {% endif %}

            {# 'silent' aborts stop right after the title and leave every wrapper open. #}
            {% if abort != 'silent' %}</div>{% endif %}
    {% endif %}

{% if abort == 'message' %}
    </div>
    </div>
{% elseif abort == '' %}
    {% if not maintenance and not preview %}</div>{% endif %}
    </div>
{% endif %}
