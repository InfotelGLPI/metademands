{#- Break towards another block, opened in the middle of the field loop of the block
 #  being rendered: this template deliberately closes wrappers it has not opened
 #  (those of block_content.html.twig) and opens wrappers block_content closes.
 #
 #  The frame colour used to be printed as a <style> block emitted twice per break;
 #  it now travels as the --md-preview-color variable read by .md-preview-tag in
 #  public/css/metademands.css.
 #
 #  title.label2 and title.comment are designer-defined rich HTML, sanitized by
 #  |safe_html; config_url is the form of the title field in the central preview.
 -#}
{% import '@metademands/fields/field_wrapper.html.twig' as wrapper %}
{%- set frame = 'padding-top:5px;padding-bottom:10px;border-top:3px solid #' ~ preview_color ~ ';border-left:3px solid #' ~ preview_color ~ ';border-right:3px solid #' ~ preview_color -%}
{%- set preview_style = '--md-preview-color:#' ~ preview_color ~ ';' ~ frame -%}
</div></div></div>
<div bloc-id="bloc{{ block }}">
{%- if title is not null -%}
    {% if is_preview %}<div class="row preview-md md-preview-tag" data-title="{{ block }}" style="{{ preview_style }}">{% else %}<div>{% endif %}
    <br><h4 class="alert alert-light"><span style="color:{{ title.color }};">
        {{- title.label -}}
        {%- if debug %} (ID:{{ title.id }}){% endif -%}
        {{- wrapper.config_link(config_url) -}}
        {%- if title.label2 is not empty %}&nbsp;<span class="form-help" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ title.label2|safe_html|e }}">?</span>{% endif -%}
        <i id="up{{ block }}" class="ti ti-chevron-up pointer" data-metademands-collapse="{{ block }}"
           style="right:40px;position:absolute;color:{{ title.color }};"></i>
    </span></h4>
    {%- if title.comment is not empty %}<label><i>{{ title.comment|safe_html }}</i></label>{% endif %}
    </div>
{%- endif %}
<div bloc-hideid="bloc{{ block }}">
{% if is_preview %}<div class="row preview-md md-preview-tag" data-title="{{ block }}" style="{{ preview_style }}">{% else %}<div class="row class1" style="background-color: {{ background_color }};padding: 0.5rem 0.5rem;">{% endif %}
