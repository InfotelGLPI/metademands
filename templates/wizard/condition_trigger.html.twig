{#- Field whose changes re-evaluate the conditions of the metademand:
 #  public/scripts/wizard_form.js (initConditionTrigger) publishes the parameters
 #  as window.metademandconditionsparams and binds the handler.
 #
 #  Expected context:
 #    params : see Condition::displayTrigger()
 #    source : see Condition::displayTrigger()
 #}
<div class="d-none"
     data-md-condition-trigger="{{ params|json_encode }}"
     data-md-condition-source="{{ source|json_encode }}"></div>
