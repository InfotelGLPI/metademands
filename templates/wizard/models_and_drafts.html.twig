{#- Toggle opening the panel that lists the models, the created forms and the drafts
 #  of the current user. Every tab body includes one or more lists, each given as
 #  {template, context} by Form::get*FormsContext() / Draft::getUserDraftsContext()
 #  (forms/*_list.html.twig). The legacy markup announced aria-selected="true" on every tab and
 #  closed a </span> it never opened.
 -#}
{#- The toggle: a button (form="" so that it never submits the wizard), handled by the
 #  delegated [data-metademands-toggle] listener of public/scripts/wizard_form.js -#}
<div class="{{ toggle_class }}">
    <button type="button" form="" class="btn btn-outline-secondary md-forms-toggle"
            data-metademands-toggle="divnavforms" aria-controls="divnavforms" title="{{ toggle_title }}">
        <i class="ti ti-folders" aria-hidden="true"></i>
        <span class="d-none d-md-inline ms-1">{{ toggle_title }}</span>
    </button>
</div>

<div id="divnavforms" class="input-draft card mb-3"
     style="display:none;position:absolute;right:0;z-index: 1000;margin-top: 50px;">
    <ul class="nav nav-tabs" id="myTab" role="tablist">
        {% for tab in tabs %}
            <li class="nav-item" role="presentation">
                <button class="nav-link{% if loop.first %} active{% endif %}" id="{{ tab.id }}-tab"
                        data-bs-toggle="tab" data-bs-target="#{{ tab.id }}" type="button" role="tab"
                        aria-controls="{{ tab.id }}" aria-selected="{{ loop.first ? 'true' : 'false' }}">
                    {{ tab.label }}
                </button>
            </li>
        {% endfor %}
        {# Closes the panel: the same toggle as the button opening it #}
        <li class="nav-item ms-auto d-flex align-items-center" role="presentation">
            <button type="button" form="" class="btn-close md-forms-close" data-metademands-toggle="divnavforms"
                    aria-controls="divnavforms" aria-label="{{ __('Close') }}" title="{{ __('Close') }}"></button>
        </li>
    </ul>

    <div class="tab-content" id="myTabContent">
        {% for tab in tabs %}
            <div id="{{ tab.id }}" class="tab-pane fade{% if loop.first %} show active{% endif %}"
                 role="tabpanel" aria-labelledby="{{ tab.id }}-tab">
                {% for list in tab.lists %}
                    {% include list.template with list.context only %}
                {% endfor %}
            </div>
        {% endfor %}
    </div>
</div>
