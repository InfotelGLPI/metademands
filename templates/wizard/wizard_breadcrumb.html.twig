<script>
    $(document).ready(function () {
        $('#title_cat').show();
        $('#categories_title').show();
        document.getElementById('title_cat').innerHTML = {{ tree_name|json_encode(constant('JSON_HEX_TAG') b-or constant('JSON_HEX_AMP'))|raw }};
        let newScript = document.createElement('script');
        newScript.type = 'text/javascript';
        {# tree_script is the JavaScript string literal produced by Category::getTreeCategoryFriendlyName(). #}
        let scriptContent = document.createTextNode({{ tree_script|raw }});
        newScript.appendChild(scriptContent);
        document.body.appendChild(newScript);
    });
</script>

<span id="categories_title" style="display: none">
    <div class="alert alert-secondary {{ alert_class }}" role="alert"
         {% if alert_style is not empty %}style="{{ alert_style }}"{% endif %}>
        <span id="title_cat"></span>
    </div>
</span>

{% if display_warning is not empty %}
    <h5>
        <div class="alert alert-danger" role="alert">
            <i style="font-size:3em;" class="ti ti-exclamation-circle"></i>
            &nbsp;{{ display_warning|nl2br }}
        </div>
    </h5>
{% endif %}

{% if faq_url is not empty %}
    <h5>
        <div class="alert alert-warning" role="alert">
            <i class="ti ti-alert-triangle" style="font-size:2em;color:orange"></i>
            &nbsp;{{ __('Did you know that there is an FAQ article that may be able to help you?', 'servicecatalog') }}
            &nbsp;
            <a href="{{ faq_url }}">
                <button form="" class="submit btn btn-info btn-sm">
                    <i class="ti ti-link" data-hasqtip="0" aria-hidden="true"></i>
                    &nbsp;{{ __('Click here for more informations', 'servicecatalog') }}
                </button>
            </a>
        </div>
    </h5>
{% endif %}
