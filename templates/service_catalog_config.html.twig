{#-
 # Service catalog tab of a metademand (ServiceCatalogConfig): the one of the core
 # (pages/admin/form/service_catalog_tab.html.twig), whose illustration can be removed.
 #
 # Expected context:
 #  - item: the metademand
 #  - icon: icon of the tab
 #  - illustration: the illustration used, its own one or the inherited one
 #  - has_own_illustration: whether the metademand has an illustration of its own
 #  - inherited_illustration: the one of its category, or the default one
 -#}
{% import 'components/form/fields_macros.html.twig' as fields %}

<form method="POST" action="{{ item.getFormURL() }}" data-submit-once>
    <div class="py-2 px-3 container-narrow ms-0">
        <h2 class="d-flex align-items-center">
            <i class="{{ icon }} me-2" aria-hidden="true"></i>
            {{ __("Service catalog configuration") }}
        </h2>
        <section>
            <div class="row">
                <div class="col-lg-10 col-12">
                    {{ fields.textareaField(
                        'description',
                        item.fields.description,
                        __('Description'),
                        {
                            'is_horizontal': false,
                            'full_width' : true,
                            'enable_richtext': true,
                            'enable_images': false,
                        }
                    ) }}
                </div>

                <div class="col-lg-2 col-12">
                    {{ fields.illustrationField(
                        'illustration',
                        illustration,
                        __('Illustration'),
                        {
                            'is_horizontal': false,
                            'full_width' : true,
                            'extra_css_classes': 'illustration-selector-extra-margin',
                        }
                    ) }}
                    {% if has_own_illustration %}
                        <label class="form-check mt-2 mb-0">
                            <input class="form-check-input" type="checkbox" name="_blank_illustration" value="1">
                            <span class="form-check-label">{{ __('Remove the illustration', 'metademands') }}</span>
                        </label>
                    {% else %}
                        {#- Saved unchanged, the inherited illustration stays inherited -#}
                        <input type="hidden" name="_inherited_illustration" value="{{ inherited_illustration }}">
                    {% endif %}
                    <div class="form-text">
                        {{ __('Without an illustration of its own, the one of its category, or the default one, is used', 'metademands') }}
                    </div>
                </div>
            </div>

            {{ fields.dropdownField(
                'Glpi\\Form\\Category',
                'forms_categories_id',
                item.fields.forms_categories_id,
                _n('Category', 'Categories', 1),
                {
                    'is_horizontal': false,
                    'full_width' : true,
                }
            ) }}

            <label class="col-form-label form-check form-switch mb-2">
                <input type="hidden" name="is_pinned" value="0">
                <input class="form-check-input" type="checkbox" name="is_pinned" value="1" {{ item.fields.is_pinned ? 'checked' : '' }}>
                <span class="form-check-label">{{ __("Pin to top of the service catalog") }}</span>
            </label>
        </section>

        {# Hidden values #}
        <input type="hidden" name="id" value="{{ item.getID() }}" />

        {# Actions #}
        <div class="d-flex mt-4">
            <button type="submit" name="update" class="btn btn-primary ms-auto">
                <i class="ti ti-device-floppy me-1 " aria-hidden="true"></i>
                {{ __("Save changes") }}
            </button>
        </div>
    </div>
</form>
