{% if canedit %}
    <div class="center first-bloc">
        <form name="ticketfield_form" method="post" action="{{ form_action }}">
            <table class="tab_cadre_fixe">
                <tr class="tab_bg_1">
                    <th colspan="6">
                        {{ __('Synchronise with ticket template', 'metademands') }} {{ template_link|raw }}
                    </th>
                </tr>
                <tr class="tab_bg_1">
                    <td class="tab_bg_2 center">
                        {{ submit_html|raw }}
                        {{ hidden_html|raw }}
                    </td>
                </tr>
                <tr class="tab_bg_1 center">
                    <td>
                        <a href="#" class="submit btn btn-primary" data-bs-toggle="modal" data-bs-target="#tags"
                           title="{{ __('Show list of available tags') }}">
                            {{ __('Show list of available tags') }}
                        </a>
                        {{ tags_modal_html|raw }}
                    </td>
                </tr>
            </table>
            {# closes the <form> above and carries the CSRF token #}
            {{ close_form_html|raw }}
    </div>
{% endif %}

<div id="{{ viewticketchild_id }}"></div>
