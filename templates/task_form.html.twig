<div class="modal fade" id="{{ modal_id }}" tabindex="-1" aria-modal="true" role="dialog">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    {{ is_new ? __('Add a child object', 'metademands') : __('Edit child object', 'metademands') }}
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"
                        aria-label="{{ __('Close') }}"></button>
            </div>

            <div class="modal-body" style="overflow-y:auto; max-height:75vh;">
                {% if not_solved %}
                    <div class="alert alert-warning d-flex align-items-center" role="alert">
                        <i class="ti ti-alert-triangle me-2" style="font-size:2em;color:orange;"></i>
                        <span>{{ __('You cannot add new tasks if linked tickets are not solved', 'metademands') }}</span>
                    </div>
                {% else %}
                    {% do item.showFormHeader(options) %}
                    {% if form_id <= 0 %}
                        {% embed '@metademands/forms/task_form_row.html.twig' with {'label': __('Task type', 'metademands')} %}
                            {% block content %}
                                {% do call('Dropdown::showFromArray', ['taskType', task_types, {'value': 0, 'rand': type_rand}]) %}
                                {% do call('Ajax::updateItemOnSelectEvent', ['dropdown_taskType' ~ type_rand, 'show_add_task_form', type_url, {
                                    'taskType': '__VALUE__',
                                    'plugin_metademands_metademands_id': parent.getID()
                                }]) %}
                            {% endblock %}
                        {% endembed %}
                    {% endif %}
                    {% embed '@metademands/forms/task_form_row.html.twig' with {'label': '', 'span_id': 'show_add_task_form'} %}
                        {% block content %}
                            {% do item.showTypeForm(parent, form_id, true) %}
                        {% endblock %}
                    {% endembed %}
                    <input type="hidden" name="plugin_metademands_metademands_id" value="{{ parent.getID() }}">
                    {% do item.showFormButtons({'colspan': 3}) %}
                {% endif %}
            </div>
        </div>
    </div>
</div>

<script>
    bootstrap.Modal.getOrCreateInstance(document.getElementById('{{ modal_id }}')).show();
</script>
