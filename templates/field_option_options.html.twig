{#-
 # Options of a field (FieldOption::showOptions()).
 #
 # Expected context:
 #  - entries: one rule per option: id, is_negated, is_regex, type_of_value, value_to_check
 #    and its actions, each {icon, color, title, text}
 #  - missing_values: value to check => name, the values no option applies to
 #  - the modal and the massive actions: canedit, modal_id, modal_title_id, viewoption_id,
 #    viewsubitem_url, load_params, reload_params, itemtype, mass_container
-#}

{% if not allowed %}
    <div class="alert alert-warning">
        {{ __('No options are allowed for this field type', 'metademands') }}
    </div>
{% elseif link_to_user %}
    <div class="alert alert-warning">
        {{ __("Options aren't available for a field whose value is linked to a user field", 'metademands') }}
    </div>
{% else %}

    {#
     # The add / edit links, and the reload of the option form when its value to check
     # changes, load the option form into this modal: see fieldoption_valuetocheck.js.
     #}
    {% if canedit %}
        <div class="modal fade" id="{{ modal_id }}" tabindex="-1"
             data-md-option-modal
             data-md-option-url="{{ viewsubitem_url }}"
             data-md-option-params="{{ load_params|json_encode }}"
             data-md-option-reload-params="{{ reload_params|json_encode }}">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="{{ modal_title_id }}"></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body" id="{{ viewoption_id }}" style="overflow-y:auto;max-height:120vh;"></div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end mb-3">
            <button type="button" class="btn btn-primary"
                    data-md-option-open="{{ modal_id }}"
                    data-md-option-id="-1"
                    data-md-option-title="{{ add_title }}">
                <i class="ti ti-plus me-1"></i>{{ add_title }}
            </button>
        </div>
    {% endif %}

    {% if entries|length > 0 or missing_values|length > 0 %}
        <div class="left">
            {% if canedit and entries|length > 0 %}
                {# raw: massive actions, no core macro (§3.2) #}
                {{ call('Html::getOpenMassiveActionsForm', [mass_container])|raw }}
                {# raw: massive actions, no core macro (§3.2) #}
                {{ call('Html::showMassiveActions', [{
                    'item': itemtype,
                    'container': mass_container,
                    'display': false
                }])|raw }}
            {% endif %}

            {#
             # One rule per option: "= value" ("≠ value" for any value but this one), then the
             # actions it carries, named, with their full label in a tooltip. A click anywhere
             # on the rule but its checkbox opens the option in the modal. Then the values no
             # option applies to, with a shortcut adding an option on that value.
             #}
            <div class="card md-rules">
                <div class="card-header py-2 d-flex align-items-center gap-2">
                    {% if canedit and entries|length > 0 %}
                        {# raw: massive actions, no core macro #}
                        {{ call('Html::getCheckAllAsCheckbox', [mass_container])|raw }}
                    {% endif %}
                    <h3 class="card-title m-0">{{ __("List of options", 'metademands') }}</h3>
                    <span class="badge bg-secondary-lt">{{ entries|length }}</span>
                </div>
                <div class="list-group list-group-flush">
                    {% for entry in entries %}
                        <div class="list-group-item md-rule{{ canedit ? ' list-group-item-action pointer' : '' }}"
                             {% if canedit %}
                                 data-md-option-open="{{ modal_id }}"
                                 data-md-option-id="{{ entry.id }}"
                                 data-md-option-title="{{ __('Edit option', 'metademands') }}"
                             {% endif %}>
                            {% if canedit %}
                                <div class="md-rule-check" data-md-option-noopen>
                                    {# raw: massive actions, no core macro #}
                                    {{ call('Html::getMassiveActionCheckBox', [itemtype, entry.id])|raw }}
                                </div>
                            {% endif %}
                            <div class="md-rule-cond">
                                {% if is_parent_field %}
                                    <span class="text-secondary">{{ __('Field') }}</span>
                                {% elseif entry.is_regex %}
                                    <span class="badge bg-cyan-lt md-rule-op" title="{{ __('Type of value to check', 'metademands') }}">{{ entry.type_of_value }}</span>
                                {% elseif entry.is_negated %}
                                    <span class="badge bg-orange-lt md-rule-op" title="{{ __('is not') }}">≠</span>
                                {% else %}
                                    <span class="badge bg-secondary-lt md-rule-op" title="{{ __('is') }}">=</span>
                                {% endif %}
                                <span class="md-rule-value" title="{{ is_parent_field ? __('Field name', 'metademands') : __('Value to check', 'metademands') }}">{{ entry.value_to_check }}</span>
                            </div>
                            {% if not is_parent_field %}
                                <i class="ti ti-arrow-right text-secondary md-rule-arrow"></i>
                                <div class="md-rule-actions">
                                    {% for action in entry.actions %}
                                        <span class="badge bg-{{ action.color }}-lt md-rule-action" title="{{ action.title }}">
                                            <i class="ti {{ action.icon }} me-1"></i>{{ action.text }}
                                        </span>
                                    {% else %}
                                        <span class="text-secondary small fst-italic">{{ __('No action', 'metademands') }}</span>
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <span class="text-secondary small md-rule-id">#{{ entry.id }}</span>
                            {% if canedit %}
                                <i class="ti ti-pencil text-secondary md-rule-edit"></i>
                            {% endif %}
                        </div>
                    {% endfor %}

                    {% for value, name in missing_values %}
                        <div class="list-group-item md-rule md-rule-none">
                            {% if canedit %}<div class="md-rule-check"></div>{% endif %}
                            <div class="md-rule-cond">
                                <span class="badge bg-secondary-lt md-rule-op">=</span>
                                <span class="md-rule-value">{{ name }}</span>
                            </div>
                            <i class="ti ti-arrow-right text-secondary md-rule-arrow"></i>
                            <div class="md-rule-actions">
                                <span class="text-secondary small fst-italic">{{ __('No option', 'metademands') }}</span>
                            </div>
                            {% if canedit %}
                                <button type="button" class="btn btn-sm btn-ghost-primary md-rule-add"
                                        data-md-option-open="{{ modal_id }}"
                                        data-md-option-id="-1"
                                        data-md-option-value="{{ value }}"
                                        data-md-option-title="{{ add_title }}">
                                    <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
                                </button>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>

            {% if canedit and entries|length > 0 %}
                {# raw: massive actions, no core macro (§3.2) #}
                {{ call('Html::showMassiveActions', [{
                    'item': itemtype,
                    'container': mass_container,
                    'ontop': false,
                    'display': false
                }])|raw }}
                </form>
            {% endif %}
        </div>
    {% else %}
        <div class="center first-bloc">
            <table class="tab_cadre_fixe">
                <tr class="tab_bg_1"><td class="center">{{ __('No results found') }}</td></tr>
            </table>
        </div>
    {% endif %}

{% endif %}
