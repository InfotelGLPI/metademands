{#-
 # Groups allowed to enter a meta-demand (Group::showForMetademand()).
 #
 # Expected context:
 #  - groups, used_groups: groups of the entity scope, those already added
 #  - add_groups_with_regex: offer the regular expression input
 #  - groups_items: added groups ({id, link, name when the group is gone, parent, entity})
 #  - excluding:    visibility "all groups and not these groups", the list holds the excluded groups
-#}
{% import 'components/form/basic_inputs_macros.html.twig' as inputs %}
{% import 'components/form/fields_macros.html.twig' as fields %}

{% if canedit %}
<form name="form" method="post" action="{{ action }}">
    {{ inputs.hidden('_glpi_csrf_token', csrf_token()) }}
    {{ inputs.hidden('plugin_metademands_metademands_id', metademand_id) }}

    <div class="card mb-3">
        <div class="card-header py-2">
            <h3 class="card-title"><i class="ti ti-users-plus me-2"></i>{{ __('Add a group', 'metademands') }}</h3>
        </div>
        <div class="card-body d-flex flex-wrap align-items-end gap-3">
            <div class="flex-grow-1" style="min-width: 300px; max-width: 520px;">
                <label class="form-label">{{ __('Group') }}</label>
                {{ fields.dropdownArrayField('groups_id', '', groups, '', {
                    'no_label': true,
                    'field_class': '',
                    'mb': '',
                    'width': '100%',
                    'multiple': true,
                    'values': [],
                    'used': used_groups
                }) }}
            </div>

            {% if add_groups_with_regex %}
                <div style="min-width: 240px;">
                    <label class="form-label">{{ __('Regular expression', 'metademands') }}</label>
                    <input type="text" name="regex_value" class="form-control">
                </div>
            {% endif %}

            <button class="btn btn-primary" type="submit" name="add_groups" value="1">
                <i class="ti ti-plus me-1"></i>{{ _x('button', 'Add') }}
            </button>
        </div>
    </div>
</form>
{% endif %}

{#- The added groups: the allowed ones, or the excluded ones with the visibility "all groups
 #  and not these groups" (Group::isUserHaveRight()) -#}
{% set rand = random() %}
{% set mass_container = 'mass' ~ rand %}

{% if canedit and groups_items|length > 0 %}
    {# raw: massive actions, no core macro (§3.2) #}
    {{ call('Html::getOpenMassiveActionsForm', [mass_container])|raw }}
    {# raw: massive actions, no core macro (§3.2) #}
    {{ call('Html::showMassiveActions', [{'item': itemtype, 'container': mass_container, 'display': false}])|raw }}
{% endif %}

<div class="card md-visibility-groups">
    <div class="card-header py-2 d-flex align-items-center gap-2">
        {% if canedit and groups_items|length > 0 %}
            {# raw: massive actions, no core macro (§3.2) #}
            {{ call('Html::getCheckAllAsCheckbox', [mass_container])|raw }}
        {% endif %}
        <h3 class="card-title m-0">
            {% if excluding ?? false %}
                <i class="ti ti-user-off text-red me-2"></i>{{ __('All groups and not these groups', 'metademands') }}
            {% else %}
                <i class="ti ti-user-check text-green me-2"></i>{{ __('Groups allowed to enter a demand', 'metademands') }}
            {% endif %}
        </h3>
        <span class="badge bg-secondary-lt">{{ groups_items|length }}</span>
    </div>
    {% if groups_items|length > 0 %}
        <div class="list-group list-group-flush">
            {% for group_item in groups_items %}
                <div class="list-group-item d-flex align-items-center gap-3 {{ (excluding ?? false) ? 'md-group-excluded' : 'md-group-allowed' }}">
                    {% if canedit %}
                        {# raw: massive actions, no core macro (§3.2) #}
                        {{ call('Html::getMassiveActionCheckBox', [itemtype, group_item.id])|raw }}
                    {% endif %}
                    <span class="avatar avatar-sm bg-secondary-lt"><i class="ti ti-users"></i></span>
                    <div class="flex-fill">
                        {% if group_item.link is not empty %}
                            {# raw: CommonDBTM::getLink() escapes the name (§3.1) #}
                            <span class="fw-semibold">{{ group_item.link|raw }}</span>
                        {% else %}
                            <span class="text-danger">{{ group_item.name }}</span>
                        {% endif %}
                        {% if (group_item.parent ?? '') is not empty or (group_item.entity ?? '') is not empty %}
                            <div class="small text-muted d-flex flex-wrap gap-3">
                                {% if (group_item.parent ?? '') is not empty %}
                                    <span title="{{ __('As child of') }}"><i class="ti ti-sitemap me-1"></i>{{ group_item.parent }}</span>
                                {% endif %}
                                {% if (group_item.entity ?? '') is not empty %}
                                    <span title="{{ __('Entity') }}"><i class="ti ti-stack me-1"></i>{{ group_item.entity }}</span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="card-body text-center text-muted py-4">
            <i class="ti ti-users fs-1 d-block mb-2"></i>
            {{ __('No results found') }}
        </div>
    {% endif %}
</div>

{% if canedit and groups_items|length > 0 %}
    {# raw: massive actions, no core macro (§3.2) #}
    {{ call('Html::showMassiveActions', [{'item': itemtype, 'container': mass_container, 'ontop': false, 'display': false}])|raw }}
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
{% endif %}
