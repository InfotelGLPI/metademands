<div class="row">
    <div class="card mx-1 my-2 flex-grow-1">
        <div class="col-12 align-self-center">
            <section class="card-body" style="width: 100%;">
                <h2 class="card-title mb-2 text-break" style="color: {{ title_color }};">
                    {{ __('Your basket', 'metademands') }}
                </h2>
                <div class="mydraft right" style="position: absolute;top: 0;margin-top: 10px;;right: 0;">
                    {{ clear_basket_html|raw }}
                </div>
                {{ hidden_meta|raw }}
                {{ hidden_form_meta|raw }}
            </section>
        </div>
    </div>
</div>

{{ lines_html|raw }}

<div class="row">
    <div class="bt-feature col-md-12 ">
        {{ previous_html|raw }}
        <span style="float:right">
            {{ submit_order_html|raw }}
        </span>
    </div>
</div>

<script>
    $('#submitOrder').click(function() {
        var meta_id = {{ meta_id }};
        $.ajax({
            url: '{{ webdir }}/ajax/addform.php',
            type: 'POST',
            data: {{ post_json|raw }},
            success: function (response) {
                $.ajax({
                    url: '{{ webdir }}/ajax/createmetademands.php',
                    type: 'POST',
                    data: {{ post_json|raw }},
                    success: function (response) {
                        window.location.href = '{{ webdir }}/front/wizard.form.php?{{ param_url|raw }}metademands_id=' + meta_id + '&step=create_metademands';
                    },
                    error: function (xhr, status, error) {
                        console.log(xhr);
                        console.log(status);
                        console.log(error);
                    }
                });
            },
            error: function (xhr, status, error) {
                console.log(xhr);
                console.log(status);
                console.log(error);
            }
        });
    });
    $('#prevBtn').hide();
    $('.step_wizard').hide();
</script>
