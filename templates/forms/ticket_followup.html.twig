{% if not has_tickets %}
    <div class="alert alert-info center">
        {{ __('There is no childs tickets', 'metademands') }}
    </div>
{% else %}
    {% if followup is not null %}
        <br>
        <div class="center alert alert-dismissible fade show informations"
             style="display:flex;align-items: center;{% if followup.has_status %}background-color: white;border-color:{{ followup.icon_color }}{% endif %}">
            {% if followup.has_status %}
                <div style="margin-right: 20px;">
                    <i class="{{ followup.icon }}" style="vertical-align: top;font-size:2em;color:{{ followup.icon_color }}"></i>
                </div>
            {% endif %}
            {{ __('Demand followup', 'metademands') }}
            {%- if followup.has_status %} - {{ followup.status_name }}{% endif %}
        </div>
    {% endif %}

    {% if list_rows|length %}
        <div class="card mt-2">
            <div class="card-header">
                <h5 class="card-title">{{ list_title }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table card-table">
                    <thead>
                        <tr>
                            <th>{{ __('Ticket') }}</th>
                            <th>{{ __('Entity') }}</th>
                            <th>{{ __('Opening date') }}</th>
                            {% if is_central %}
                                <th>{{ __('Assigned to') }}</th>
                            {% endif %}
                            <th class="text-center">{{ __('Status') }}</th>
                            {% if is_central %}
                                <th>{{ __('Due date', 'metademands') }}</th>
                                <th>{{ __('Status') }} {{ __('SLA') }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in list_rows %}
                            <tr class="{{ row.is_closed ? 'closedchild' : '' }}">
                                <td>
                                    {% if row.indent_px %}
                                        <div style="margin-left:{{ row.indent_px }}px" class="metademands_tree"></div>
                                    {% endif %}
                                    {% if row.has_ticket %}
                                        <a href="{{ row.ticket_url }}">{{ row.ticket_name }}</a>
                                    {% else %}
                                        {{ row.task_name }}
                                    {% endif %}
                                </td>
                                <td>{{ row.entity }}</td>
                                <td>{{ row.date }}</td>
                                {% if is_central %}
                                    <td>
                                        {%- for name in row.assigned -%}
                                            {{ name }}{% if not loop.last %}<br>{% endif %}
                                        {%- endfor -%}
                                    </td>
                                {% endif %}
                                <td class="text-center">
                                    <i class="{{ row.status_icon }}" style="font-size:2em;color:{{ row.status_icon_color }}"></i>
                                    {{ row.status_name }}
                                </td>
                                {% if is_central %}
                                    <td class="{{ row.color_class }}">
                                        {% if row.show_late_icon %}
                                            <i class="ti ti-alert-triangle" style="font-size:2em;color:darkred"></i>
                                        {% endif %}
                                        {{ row.time_to_resolve }}
                                    </td>
                                    <td>{{ row.sla_state }}</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}

    {% if next_rows|length %}
        {% set grey_class = 'metademand_metademandfollowup_grey' %}
        <div class="card mt-2">
            <div class="card-header">
                <h5 class="card-title">{{ __('Next tickets', 'metademands') }}</h5>
            </div>

            <div class="table-responsive">
                <table class="table card-table">
                    <thead>
                        <tr>
                            <th>{{ __('Ticket') }}</th>
                            <th>{{ __('Opening date') }}</th>
                            {% if is_central %}
                                <th>{{ __('Assigned to') }}</th>
                            {% endif %}
                            <th class="text-center">{{ __('Status') }}</th>
                            {% if is_central %}
                                <th>{{ __('Due date', 'metademands') }}</th>
                                <th>{{ __('Status') }} {{ __('SLA') }}</th>
                            {% endif %}
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in next_rows %}
                            <tr>
                                <td class="{{ grey_class }}">
                                    {% if row.indent_px %}
                                        <div style="margin-left:{{ row.indent_px }}px" class="metademands_tree"></div>
                                    {% endif %}
                                    {{ row.task_name }}
                                </td>
                                <td class="{{ grey_class }}">{{ row.date }}</td>
                                {# The legacy code computed the assigned actors here but never printed
                                   them, and the row is always built from an empty ticket anyway. #}
                                {% if is_central %}
                                    <td class="{{ grey_class }}"></td>
                                {% endif %}
                                <td class="{{ grey_class }} text-center">
                                    <i class="ti ti-hourglass-high"></i>
                                    {{ __('Coming', 'metademands') }}
                                </td>
                                {% if is_central %}
                                    <td class="{{ grey_class }}">{{ row.time_to_resolve }}</td>
                                    <td class="{{ grey_class }}">{{ row.sla_state }}</td>
                                {% endif %}
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    {% endif %}
{% endif %}
