{#- Once the next recipient is chosen, closing the modal leaves the form for the ticket
 #  list: public/scripts/wizard_form.js redirects when modal_id is hidden.
 #
 #  Expected context:
 #    modal_id     : id of the modal built by Ajax::createIframeModalWindow()
 #    redirect_url : absolute path to go to
 #}
<div class="d-none" data-metademands-redirect-on-close="{{ modal_id }}" data-metademands-redirect-url="{{ redirect_url }}"></div>
