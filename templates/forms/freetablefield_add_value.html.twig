<form method="post" action="{{ form_action }}">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1">
            <td id="show_custom_fields">
                <span id="internal_name_values{{ rank }}">
                    {{ __('Rank', 'metademands') }} {{ rank }}<br>
                    {{ __('Internal name', 'metademands') }} {{ internal_name_tooltip|raw }}
                    {{ internal_name_input|raw }}
                </span>
            </td>
            <td id="show_custom_fields">
                <span id="type_values{{ rank }}">
                    <br>{{ __('Type', 'metademands') }}<br>
                    {{ type_dropdown|raw }}
                    {{ type_script|raw }}
                </span>
            </td>
            <td id="show_custom_fields">
                <span id="custom_values{{ rank }}">
                    <br>{{ __('Display name', 'metademands') }} {{ display_name_input|raw }}
                </span>
            </td>
            <td id="show_custom_fields">
                <span class="newdropdownvalue{{ rank }}" id="dropdown_values{{ rank }}" style="display:none">
                    <br>{{ __('Dropdown values', 'metademands') }} {{ dropdown_values_tooltip|raw }}
                    {{ dropdown_values_textarea|raw }}
                </span>
            </td>
            <td id="show_custom_fields">
                <span class="newcomment{{ rank }}" id="comment_values{{ rank }}" style="display:none">
                    <br>{{ __('Comment') }} {{ comment_input|raw }}
                </span>
            </td>
            <td id="show_custom_fields">
                <span id="is_mandatory_values{{ rank }}">
                    <br>{{ __('Mandatory', 'metademands') }}<br>
                    {{ mandatory_yesno|raw }}
                </span>
            </td>
            {{ hidden_rank|raw }}
            {{ hidden_fields_id|raw }}
        </tr>
        <tr class="tab_bg_1">
            <td>{{ submit_html|raw }}</td>
        </tr>
    </table>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>
