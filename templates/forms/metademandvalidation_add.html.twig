<div class="center first-bloc">
    <form name="field_form" method="post" action="{{ form_action }}">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="6">{{ __('Add a field', 'metademands') }}</th>
            </tr>
            {% if canedit %}
                <tr class="tab_bg_1">
                    <td class="tab_bg_2 center" colspan="6">
                        {{ hidden_html|raw }}
                        {{ submit_html|raw }}
                    </td>
                </tr>
            {% endif %}
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
</div>
