<div class="center first-bloc">
    <form name="field_form" method="post" action="{{ form_action }}">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_1">
                <th colspan="6">{{ __('Add a field', 'metademands') }}</th>
            </tr>
            {% if canedit %}
                <tr class="tab_bg_1">
                    <td class="tab_bg_2 center" colspan="6">
                        <input type="hidden" name="plugin_metademands_metademands_id" value="{{ metademands_id }}">
                        <button type="submit" name="add" value="{{ _x('button', 'Add') }}" class="btn btn-primary">
                            <span>{{ _x('button', 'Add') }}</span>
                        </button>
                    </td>
                </tr>
            {% endif %}
        </table>
    </form>
</div>
