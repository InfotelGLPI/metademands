{#
 # Forms already filled for the ITIL object, listed in its "metademands" tab.
 #
 # Expected context:
 #  - title:       heading of the card
 #  - entries:     rows {meta_name, date, by, id, meta_id, users_id}
 #  - step, items_id, itemtype, webdir, is_validate: parameters of loadForm()
 #}

{% if entries is not empty %}
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="card-title">{{ title }}</h5>
        </div>

        <div class="table-responsive">
            <table class="table card-table">
                <thead>
                    <tr>
                        <th>{{ __('Name') }}</th>
                        <th>{{ __('Creation date') }}</th>
                        <th>{{ __('By') }}</th>
                        <th class="text-end">{{ __('See form', 'metademands') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for entry in entries %}
                        <tr>
                            <td>{{ entry.meta_name }}</td>
                            <td>{{ entry.date }}</td>
                            <td>{{ entry.by }}</td>
                            <td class="text-end">
                                <button form="" class="btn btn-sm btn-outline-secondary"
                                        title="{{ _x('button', 'Load form', 'metademands') }}"
                                        onclick="loadForm({{ entry.id }}, {{ entry.meta_id }}, {{ entry.users_id }})">
                                    <i class="ti ti-cloud-download" aria-hidden="true"></i>
                                </button>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        var step = {{ step }};
        function loadForm(form_id, meta_id, users_id) {
            $('#ajax_loader').show();
            var data_send = {
                plugin_metademands_forms_id: form_id,
                metademands_id: meta_id,
                _users_id_requester: users_id,
                items_id: {{ items_id }},
                itemtype: '{{ itemtype }}'
            };
            $.ajax({
                url: '{{ webdir }}/ajax/loadform.php',
                type: 'POST',
                data: data_send,
                success: function(response) {
                    if (response == 0) {
                        $('#ajax_loader').hide();
                        window.location.href = '{{ webdir }}/front/wizard.form.php?current_ticket_id={{ items_id }}&meta_validated={{ is_validate }}&see_form=1&metademands_id=' + meta_id + '&step=' + step;
                    }
                }
            });
        }
    </script>
{% endif %}
