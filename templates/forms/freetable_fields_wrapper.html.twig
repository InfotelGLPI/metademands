{#
 # Expected context:
 #  - title        string  section heading
 #  - tooltip      string  help shown next to the heading
 #  - params       array   field parameters; the rows are printed by the
 #                         Freetable::showFreetableFields() field class
 #}

<table class="tab_cadre_fixe">
    <tr class="tab_bg_1">
        <th colspan="5">
            {{ title }}&nbsp;<i class="ti ti-info-circle" data-bs-toggle="tooltip" title="{{ tooltip }}"></i>
        </th>
    </tr>
    {% do call('GlpiPlugin\\Metademands\\Fields\\Freetable::showFreetableFields', [params]) %}
</table>
