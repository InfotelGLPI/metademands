{#
 # Expected context:
 #  - itemtype       string  class handling the massive actions
 #  - mass_container string  unique container name shared by the form and the checkboxes
 #  - canedit        bool    whether the massive action controls are shown
 #  - entries        list    [{id, metademand_name, entity_name}, ...]
 #}

<div class="left">
    {% if canedit %}
        {{ call('Html::getOpenMassiveActionsForm', [mass_container])|raw }}
        {{ call('Html::showMassiveActions', [{
            'item': itemtype,
            'container': mass_container,
            'display': false
        }])|raw }}
    {% endif %}

    <table class="tab_cadre_fixe">
        <tr>
            <th colspan="3">{{ __('Meta-demands linked', 'metademands') }}</th>
        </tr>
        <tr>
            {% if canedit %}
                <th width="10">{{ call('Html::getCheckAllAsCheckbox', [mass_container])|raw }}</th>
            {% endif %}
            <th>{{ __('Name') }}</th>
            <th>{{ __('Entity') }}</th>
        </tr>

        {% for entry in entries %}
            <tr class="tab_bg_1">
                {% if canedit %}
                    <td width="10">{{ call('Html::getMassiveActionCheckBox', [itemtype, entry.id])|raw }}</td>
                {% endif %}
                <td>{{ entry.metademand_name }}</td>
                <td>{{ entry.entity_name }}</td>
            </tr>
        {% endfor %}
    </table>

    {% if canedit %}
        {{ call('Html::showMassiveActions', [{
            'item': itemtype,
            'container': mass_container,
            'ontop': false,
            'display': false
        }])|raw }}
        {# closeForm() emits the CSRF token and the closing </form> tag #}
        {{ call('Html::closeForm', [false])|raw }}
    {% endif %}
</div>
