{% if entries is not empty %}
    <table class="tab_cadre_fixe">
        <thead>
            <tr class="center">
                <th colspan="3">{{ title }}</th>
            </tr>
            <tr class="tab_bg_1">
                <th>{{ __('Name') }}</th>
                <th>{{ __('Creation date') }}</th>
                <th>{{ __('See form', 'metademands') }}</th>
            </tr>
        </thead>
        <tbody>
            {% for entry in entries %}
                <tr class="tab_bg_1">
                    <td>{{ entry.meta_name }}</td>
                    <td>{{ entry.date }}</td>
                    <td>
                        <button form="" class="submit btn btn-success btn-sm"
                                onclick="loadForm({{ entry.id }}, {{ entry.meta_id }}, {{ entry.items_id }}, '{{ entry.itemtype }}')">
                            <i class="ti ti-cloud-download pointer" style="font-size:2em"
                               title="{{ _x('button', 'Load form', 'metademands') }}"
                               data-hasqtip="0" aria-hidden="true"></i>
                        </button>
                    </td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <script>
        var step = {{ step }};
        function loadForm(form_id, meta_id, items_id, itemtype) {
            $('#ajax_loader').show();
            var data_send = {
                plugin_metademands_forms_id: form_id,
                metademands_id: meta_id,
                _users_id_requester: {{ users_id }},
                items_id: items_id,
                itemtype: itemtype
            };
            $.ajax({
                url: '{{ webdir }}/ajax/loadform.php',
                type: 'POST',
                data: data_send,
                success: function(response) {
                    if (response == 0) {
                        $('#ajax_loader').hide();
                        window.location.href = '{{ webdir }}/front/wizard.form.php?see_form=1&metademands_id=' + meta_id + '&step=' + step;
                    }
                }
            });
        }
    </script>
{% else %}
    <div class="alert alert-info center">{{ __('No results found') }}</div>
{% endif %}
