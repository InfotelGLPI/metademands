{# Font Awesome class of a metademand icon. The stored value is either a bare icon name
 # ("fa-cubes") or already carries its style prefix ("fas fa-user-friends", "fab fa-github",
 # "fa-solid fa-lock"): "fas" is only added in the first case, so it is never doubled. #}
{% macro fa_class(icon) -%}
    {%- set has_prefix = icon matches '/(^|\\s)(fa[srlbdt]|fa-(solid|regular|light|thin|duotone|brands))(\\s|$)/' -%}
    {{- has_prefix ? icon : 'fas ' ~ icon -}}
{%- endmacro %}
