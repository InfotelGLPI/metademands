{#
 # Dismissible banner telling the current user how many step forms await them.
 # Rendered by Stepform::showWaitingWarning() on the helpdesk home page.
 #
 # Expected context:
 #  - count: number of forms waiting, always greater than zero
 #  - url:   link to front/stepform.php
 #}

<div class="alert alert-warning alert-dismissible fade show text-center" role="alert">
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="{{ __('Close') }}"></button>
    <i class="ti ti-alert-triangle" style="font-size: 2em" aria-hidden="true"></i>
    {{ __('You have %s', 'metademands')|format(count) }}
    {{ _n('form', 'forms', count, 'metademands') }}
    {{ __('to complete', 'metademands') }}
    <a href="{{ url }}">
        {{ count == 1 ? __('Do you want to see him ?', 'metademands') : __('Do you want to see them ?', 'metademands') }}
    </a>
</div>
