{#-
 # Link to the item a dropdown condition compares against, as shown in the
 # read-only summary of the conditions of a metademand.
 #
 # Expected context:
 #  - url:  target of the link
 #  - name: name of the item, stored raw in the database
 #  - id:   identifier of the item
-#}
<a href="{{ url }}" style="color:royalblue;">{{ name }} ({{ id }})</a>
