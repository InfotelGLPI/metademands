<form name='nextGroup_form' method='post' action='{{ form_action }}'>
<table class='tab_cadre_fixe'>
{% if session_set %}
    {{- common_hidden_html|raw }}
    {% if has_supervisor %}
        <div class='alert alert-warning d-flex'>
        <i class='ti ti-circle-check' style='color: orange'></i>
        &nbsp;{{ __('Your form will be validated by your supervisor', 'metademands') }}&nbsp;{{ supervisor_name|raw }}
        {{- next_users_id_hidden|raw }}
        <tr class='tab_bg_1'>
        <td colspan='2'>
        {{- submit_html|raw }}
        </td>
        </tr>
    {% else %}
        <div class='alert alert-danger alert-danger d-flex'>
        <b>{{ __("You haven't defined supervisor, you cannot continue this request", 'metademands') }}</b></div>
    {% endif %}
    </table>
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
{% endif %}
