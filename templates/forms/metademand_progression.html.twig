{#- Progression chart of a demand: one step per son ticket, framed by the creation
 #  date of the parent demand and by its completion date. The step icon comes from
 #  the servicecatalog category configuration, the ticket title from its requester;
 #  both are escaped here.
 -#}
{{ css_html|raw }}
<div class="row">
    <div class="col-12 col-lg-12">
        <ul class="process-chart">
            <li class="entry-title align-items-center d-flex justify-content-center my-4 pb-6 fs-2 fw-bold">
                <i class="ti ti-brand-databricks me-1"></i>
                <span>{{ __('Progression of your demand', 'metademands') }}</span>
            </li>

            <li class="entry-point fs-3">
                <span class="icon-stack fa-2x">
                    <i class="ti ti-circle-dashed"></i>
                    <i class="ti ti-calendar" style="font-size: 0.5em;"></i>
                </span>
                <span>{{ __('Creation date') }}&nbsp;:&nbsp;{{ creation_date }}</span>
            </li>

            {% for step in steps %}
                <li class="step">
                    <a class="btn flex-column fs-3{% if step.is_closed %} closedchild{% endif %}" href="{{ step.url }}">
                        <div class="d-flex align-items-center">
                            <i class="{{ step.icon }}" style="float: right;"></i>
                            <span>&nbsp;{{ step.name }}</span>
                        </div>
                        <div class="text-muted">
                            <br>
                            <i class="{{ step.status_icon }}"></i>&nbsp;{{ step.date }}
                        </div>
                    </a>
                </li>
            {% endfor %}

            <li class="end fs-3 ">
                <span class="icon-stack fa-2x">
                    <i class="ti ti-circle-dashed"></i>
                    <i class="ti {{ end_icon }}" style="font-size: 0.5em;"></i>
                </span>
                <span>{{ end_date }}</span>
            </li>
        </ul>
        <br><br>
    </div>
</div>
