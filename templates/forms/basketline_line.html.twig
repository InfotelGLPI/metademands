{#- One line of an order basket, included by forms/basketline_summary.html.twig. That
 #  summary sits inside #wizard_form, so the delete button does not rely on this form:
 #  public/scripts/wizard_form.js posts its data-md-basketline-post fields.
 -#}
<form method="post" action="{{ target }}">
    <input type="hidden" name="metademands_id" value="{{ metademands_id }}">
    <input type="hidden" name="form_metademands_id" value="{{ metademands_id }}">
    <table class="tab_cadre_fixehov" style="border: 3px #CCC solid;">
        {% for row in rows %}
            <tr class="tab_bg_1" id-field="{{ row.id_field }}">
                <td>
                    {{ row.label_text }}
                    {% if row.label2_text is not null %}
                        <br><br><br>{{ row.label2_text }}
                    {% endif %}
                    <span class="metademands_wizard_red" id="metademands_wizard_red{{ row.field_id }}">
                        {%- if row.mandatory %}*{% endif -%}
                    </span>
                </td>
                {# raw: wizard widget of any field type, printed by Field::getFieldInput(), whose renderers are not all in Twig yet #}
                <td>{{ row.input_html|raw }}</td>
            </tr>
        {% endfor %}
        <tr class="tab_bg_1">
            <td class="center">
                <button type="submit" class="submit btn btn-primary" name="update_basket_line"
                        value="{{ idline }}" title="{{ _x('button', 'Update this line', 'metademands') }}">
                    <i class="ti ti-device-floppy" data-hasqtip="0" aria-hidden="true"></i>
                </button>
            </td>
            <td class="center">
                <button type="button" class="btn btn-danger" title="{{ _x('button', 'Delete this line', 'metademands') }}"
                        data-md-basketline-post="{{ {'delete_basket_line': idline, 'metademands_id': metademands_id}|json_encode }}">
                    <i class="ti ti-trash"></i>
                    <span class="sr-only">{{ _x('button', 'Delete this line', 'metademands') }}</span>
                </button>
            </td>
        </tr>
    </table>
</form>
