{#-
 # Delete button of a step form (was Html::showSimpleForm(), a link posting through JS).
 #
 # Expected context:
 #  - delete_action: front/stepform.form.php
 #  - delete_button: name of the posted button (delete_form_from_list or
 #                   delete_form_from_metademands)
 #  - stepforms_id:  identifier of the step form
-#}
<form method="post" action="{{ delete_action }}" class="d-inline">
    <input type="hidden" name="plugin_metademands_stepforms_id" value="{{ stepforms_id }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    <button type="submit" name="{{ delete_button }}" value="1" class="btn btn-link text-danger p-0"
            title="{{ _x('button', 'Delete form', 'metademands') }}">
        <i class="ti ti-trash"></i><span class="sr-only">{{ _x('button', 'Delete form', 'metademands') }}</span>
    </button>
</form>
