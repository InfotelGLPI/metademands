{#- Validation of a meta-demand (MetademandValidation::viewValidation()).
 #
 #  - group_url: AJAX endpoint reloading the group selector when the choice changes
 #  - group_condition, group_value: assignable groups and current assigned group -#}
<form name="form_raz" id="form_raz" method="post" action="{{ form_action }}">
    <input type="hidden" name="action" id="action_validationMeta" value="validationMeta">
    <input type="hidden" name="tickets_id" id="action_validationMeta" value="{{ tickets_id }}">
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1 center">
            <th colspan="2">{{ __('Metademand validation', 'metademands') }}</th>
        </tr>
        <tr class="tab_bg_1 center">
            {% if is_to_validate %}
                {% if show_both_options %}
                    <td>{{ __('Create sub-tickets', 'metademands') }} &nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket" value="1" checked>
                    </td>
                    <td>{{ __('Create tasks', 'metademands') }}&nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket2" value="0">
                    </td>
                {% else %}
                    <td>{{ __('Create tasks', 'metademands') }}&nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket2" value="0">
                    </td>
                {% endif %}
                </tr>
                <tr class="tab_bg_1 center" id="to_update_group">
                {% for radio_id in ['create_subticket', 'create_subticket2'] %}
                    {% do call('Ajax::updateItemOnEvent', [radio_id, 'to_update_group', group_url, {
                        'create_subticket': '__VALUE__',
                        'tickets_id': tickets_id
                    }]) %}
                {% endfor %}
            {% elseif is_to_validate_withouttask %}
                <td colspan="2">{{ __('Attribute ticket to ', 'metademands') }} &nbsp;
                    <input type="hidden" name="create_subticket" value="{{ assign_only }}">
                    {% do call('Group::dropdown', [{
                        'condition': group_condition,
                        'name': 'group_to_assign',
                        'value': group_value
                    }]) %}
                </td>
            {% elseif is_tasks_created %}
                <div class="alert alert-success d-flex">{{ __('Tasks are created', 'metademands') }}</div>
            {% elseif is_validate_without_task %}
            {% else %}
                <div class="alert alert-success d-flex">{{ __('Sub-tickets are created', 'metademands') }}</div>
            {% endif %}
        </tr>
        {% if has_validator %}
            <tr class="tab_bg_1 center">
                <td colspan="4">{{ validated_by_text }}</td>
            </tr>
        {% endif %}
        {% if show_submit %}
            <tr class="tab_bg_1">
                <td colspan="2" class="center">
                    <button type="submit" name="btnAddAll" value="{{ __('Validate metademands', 'metademands') }}" class="btn btn-primary">
                        <span>{{ __('Validate metademands', 'metademands') }}</span>
                    </button>
                </td>
            </tr>
        {% endif %}
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
