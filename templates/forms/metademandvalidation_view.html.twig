<form name="form_raz" id="form_raz" method="post" action="{{ form_action }}">
    {{ action_hidden|raw }}
    {{ tickets_hidden|raw }}
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1 center">
            <th colspan="2">{{ __('Metademand validation', 'metademands') }}</th>
        </tr>
        <tr class="tab_bg_1 center">
            {% if is_to_validate %}
                {% if show_both_options %}
                    <td>{{ __('Create sub-tickets', 'metademands') }} &nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket" value="1" checked>
                    </td>
                    <td>{{ __('Create tasks', 'metademands') }}&nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket2" value="0">
                    </td>
                {% else %}
                    <td>{{ __('Create tasks', 'metademands') }}&nbsp;
                        <input type="radio" name="create_subticket" id="create_subticket2" value="0">
                    </td>
                {% endif %}
                </tr>
                <tr class="tab_bg_1 center" id="to_update_group">
                {{ ajax_scripts_html|raw }}
            {% elseif is_to_validate_withouttask %}
                <td colspan="2">{{ __('Attribute ticket to ', 'metademands') }} &nbsp;
                    {{ create_subticket_hidden|raw }}
                    {{ group_dropdown_html|raw }}
                </td>
            {% elseif is_tasks_created %}
                <div class="alert alert-success d-flex">{{ __('Tasks are created', 'metademands') }}</div>
            {% elseif is_validate_without_task %}
            {% else %}
                <div class="alert alert-success d-flex">{{ __('Sub-tickets are created', 'metademands') }}</div>
            {% endif %}
        </tr>
        {% if has_validator %}
            <tr class="tab_bg_1 center">
                <td colspan="4">{{ validated_by_text }}</td>
            </tr>
        {% endif %}
        {% if show_submit %}
            <tr class="tab_bg_1">
                <td colspan="2" class="center">{{ submit_html|raw }}</td>
            </tr>
        {% endif %}
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
