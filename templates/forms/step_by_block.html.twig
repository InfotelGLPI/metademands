{#- The editor of a visibility is loaded into viewstep_div_id by
 #  public/scripts/metademands_reload.js, from the data-md-reload attributes.
 #}
{% if canedit %}
    <br><div id='{{ viewstep_div_id }}'></div>
    <div class='center'>
        <button type='button' class='submit btn btn-primary'
                data-md-reload-event='click' data-md-reload='{{ add_reload|json_encode }}'>
            {{ __('Define a new visibility', 'metademands') }}
        </button>
    </div>
{% endif %}

{% if warning_blocks %}
    <div class='alert alert-warning d-flex'>
        <i style='font-size:3em;' class='ti ti-alert-triangle'></i>&nbsp;
        {{- __('Be careful if all blocks are not assigned, they will be displayed to the last assigned group', 'metademands') }}
    </div>
{% endif %}

<link rel='stylesheet' type='text/css' href='{{ css_path('/plugins/metademands/css/_process-chart.css') }}'>
<div class='row'>
    <div class='col-12 col-lg-12'>
        <ul class='process-chart'>
            <li class='align-items-center d-flex justify-content-center my-4 pb-6 fs-1 fw-bold'>
                <i class='ti ti-brand-databricks me-1'></i>
                <span>{{ __('List of visibilities', 'metademands') }}</span>
            </li>
            {% if has_blocks %}
                {% for card in cards %}
                    <li class='step'>
                        <a class='btn flex-column' href='#'
                           {%- if card.edit_reload is not empty %} style='cursor:pointer' data-md-reload-event='click' data-md-reload='{{ card.edit_reload|json_encode }}'{% endif %}>
                            <div class='d-flex align-items-center'>
                                 <i class='ti ti-align-box-left-middle'></i>
                                <span>&nbsp;{{ card.block_type_label }}&nbsp;-&nbsp;{{ card.block_label }}</span>
                            </div>
                            <div class='text-muted'>
                                {%- if card.visibility.mode == 'groups' %}
                                    <i class="ti ti-user-check"></i>&nbsp;
                                    {{- _n('Only visible for this group', 'Only visible for these groups', card.visibility.groups|length, 'metademands') -}}
                                    &nbsp;:<br>
                                    {% for group in card.visibility.groups %}{{ group }}<br>{% endfor %}
                                {%- elseif card.visibility.mode == 'supervisor' %}
                                    <i class="ti ti-user-check"></i>&nbsp;{{ __('Only visible by supervisor', 'metademands') }}
                                {%- elseif card.visibility.mode == 'all' %}
                                    {{- __('Visible by all', 'metademands') -}}
                                {%- endif %}
                                {%- if card.visibility.message is not empty %}
                                    <br><br><i class="ti ti-message-plus"></i>&nbsp;{{ card.visibility.message }}
                                {%- endif %}
                            </div>
                        </a>
                        {#- raw: Html::showSimpleForm() output, a core-built link carrying its own escaping #}
                        <div class='btn flex-column' style='color:darkred'>{{ card.delete_form_html|raw }}</div>
                    </li>
                {% endfor %}
                <li class='end'>
                    <i class='ti ti-circle-check me-1'></i>
                    <span>{{ __('The object is created', 'metademands') }}</span>
                </li>
            </ul>
        </div>
    {% else %}
        <div class='center b'>{{ __('No visibility defined', 'metademands') }}</div>
    {% endif %}

{% if setup_problem %}
    <div class='row'>
        <div class='col-12 col-lg-12'>
            <div class='center alert alert-danger' style='margin-top:20px'>
                <i class='ti ti-alert-circle' style='color: darkred'></i>&nbsp;
                {{- __('There is a problem with the setup', 'metademands') }}<br>{{ __('Your blocks are not all defined', 'metademands') }}&nbsp;
            </div>
        </div>
    </div>
{% endif %}
