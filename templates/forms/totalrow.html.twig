{#
 # Response of ajax/totalrow.php: the total of a basket line, followed by the hidden
 # input carrying the line key back to the wizard form.
 #
 # Expected context:
 #  - show_total: whether an order plugin prices this metademand
 #  - is_price:   whether the total is an amount (a plain quantity otherwise)
 #  - total:      the already formatted total
 #  - check, name, key: identifiers of the basket line
 #}

{% if show_total %}{{ total }}{% if is_price %}&nbsp;€{% endif %}{% endif %}
<input class="form-check-input" type="hidden"
       check="{{ check }}"
       name="{{ name }}"
       key="{{ key }}"
       id="{{ name }}"
       value="{{ key }}">
