{% if rows %}
    <table class="tab_cadre_fixe">
        <tr>
            <th>{{ __('ID') }}</th>
            <th>{{ __('Publisher', 'metademands') }}</th>
            <th>{{ __('Next group in charge of demand', 'metademands') }}</th>
            <th>{{ __('Next user in charge of demand', 'metademands') }}</th>
            <th>{{ __('Date') }}</th>
            <th></th>
        </tr>
        {% for row in rows %}
            <tr>
                <td>{{ row.id }}</td>
                <td>{{ row.publisher_html|raw }}</td>
                <td>{{ row.group_html|raw }}</td>
                <td>{{ row.user_dest_html|raw }}</td>
                <td>{{ row.date }}</td>
                <td>{{ row.delete_html|raw }}</td>
            </tr>
        {% endfor %}
    </table>
{% else %}
    <div class="alert alert-info center">{{ __('No results found') }}</div>
{% endif %}
