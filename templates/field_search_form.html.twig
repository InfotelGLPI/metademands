<form name="form" method="post" action="{{ form_action }}">
    <div class="center">
        <table class="tab_cadre_fixe">
            <tr class="tab_bg_2">
                <td class="center"><b>{{ __('Filter', 'glpi') }}&nbsp;</b></td>
                <td class="center">
                    {{ __('Block', 'metademands') }}&nbsp;{{ block_dropdown_html|raw }}
                </td>
                <td class="center">
                    {{ __('Field type', 'metademands') }}&nbsp;{{ type_dropdown_html|raw }}
                </td>
                <td class="center">
                    <span id="plugin_metademands_item">
                        {%- if show_item -%}
                            {{ __('Object', 'metademands') }}&nbsp;{{ item_dropdown_html|raw }}
                        {%- endif -%}
                    </span>
                </td>
                <td>
                    {{ hidden_html|raw }}
                    {{ submit_html|raw }}
                </td>
            </tr>
        </table>
    </div>
    {# emitted after the table: the legacy code placed it between two <td>, where the
       parser hoists it out anyway #}
    {{ reload_script_html|raw }}
    {# closes the <form> above and carries the CSRF token #}
    {{ close_form_html|raw }}
