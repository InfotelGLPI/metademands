{#
 # Shared export form: one row per available export format.
 #
 # Expected context:
 #  - target:       form action URL
 #  - hidden_name:  name of the hidden input carrying the exported item id
 #  - hidden_value: the exported item id
 #  - rows:         list of {label, button_name, button_label}
 #}

<form name="form" method="post" action="{{ target }}" enctype="multipart/form-data">
    {{ call('Html::hidden', [hidden_name, {'value': hidden_value}])|raw }}
    <div class="card mt-2">
        <div class="card-header">
            <h5 class="card-title">{{ __('Export') }}</h5>
        </div>
        <div class="card-body">
            {% for row in rows %}
                <div class="row align-items-center{{ loop.last ? '' : ' mb-3' }}">
                    <div class="col-sm-8">{{ row.label }}</div>
                    <div class="col-sm-4 text-end">
                        {{ call('Html::submit', [row.button_label, {
                            'name': row.button_name,
                            'class': 'btn btn-primary'
                        }])|raw }}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>
    {# closeForm() emits the CSRF token and the closing </form> tag #}
    {{ call('Html::closeForm', [false])|raw }}
