{#-
 # Web-icon selector of one custom-value row: the <select> turned into a picker by
 # the core WebIconSelector module, plus the checkbox that clears the current icon.
 # Rendered by FieldCustomvalue::showIconSelector(), the single source of the four
 # call sites that used to inline this block (Checkbox, Radio, Dropdownmeta and
 # FieldCustomvalue::addNewValue).
 #
 # Expected context:
 #  - select_html: Html::select() markup of the icon field
 #  - script_html: Html::script() + Html::scriptBlock() wiring the picker
 #  - key:         index of the row, used by the _blank_picture[] input
-#}
{{ select_html|raw }}
{{ script_html|raw }}
&nbsp;<label class="fw-normal mb-0"><input type="checkbox" name="_blank_picture[{{ key }}]">&nbsp;{{ __('Clear') }}</label>
