{#-
 # Web-icon selector of one custom-value row: the core web icon picker, plus the
 # checkbox that clears the current icon. Included by field_customvalue_list.html.twig
 # and field_customvalue_add.html.twig.
 #
 # Expected context:
 #  - key:  index of the row, carried by the icon[] and _blank_picture[] inputs
 #  - icon: currently selected icon, empty on a new row
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

<div class="d-flex align-items-center gap-1">
    {{ fields.dropdownWebIcons('icon[' ~ key ~ ']', icon, '', {
        'no_label': true,
        'field_class': '',
        'mb': '',
        'width': '175px',
    }) }}
    <label class="fw-normal mb-0 text-nowrap"><input type="checkbox" name="_blank_picture[{{ key }}]">&nbsp;{{ __('Clear') }}</label>
</div>
