{#- Selection tiles of one device list.
 #
 #  Expected context:
 #    items : rows built by Dropdownmeta::buildDeviceRow(), each holding
 #            varname, values_name, value, selected, picture_url (model picture) or
 #            icon (icon of the type), name, comment (serial number) and typename
 #
 #  The highlight of the picked tile is handled by public/scripts/dropdownmeta_device.js,
 #  which finds the tiles through the data-metademands-device marker.
-#}
{%- for item in items -%}
    <label id="{{ item.varname }}"
           class="btn md_buttonelt col-md-2 center {{ item.selected ? 'active md_buttonelt_color' : '' }}"
           data-metademands-device>
        <input type="radio" class="my_items" name="{{ item.values_name }}" value="{{ item.value }}"
               {{ item.selected ? 'checked' : '' }}>
        <div class="center">
            {%- if item.picture_url is not empty -%}
                <img class="user_picture" style="width: 30%;height: 30%;" alt="{{ _n('Picture', 'Pictures', 1) }}" src="{{ item.picture_url }}">
            {%- elseif 'fa-' in item.icon -%}
                <i style="font-size:4em" class="fas {{ item.icon }} fa-3x mr-3"></i>
            {%- else -%}
                <i style="font-size:4em" class="ti {{ item.icon }} mr-3"></i>
            {%- endif -%}
            &nbsp;
            <h5 class="mt-0 mb-1 buttonelt-title">
                {{ item.name }}&nbsp;{% if item.comment is not empty %}&nbsp;<span class="form-help" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-title="{{ item.comment }}">?</span>{% endif %}
            </h5>
            <br>{{ item.typename }}
        </div>
    </label>
{%- endfor -%}
