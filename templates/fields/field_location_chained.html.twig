{#-
 # Cascading location selector: the <select> driven by jquery.chained.selects.js, wired
 # by public/scripts/wizard_form.js (data-md-chained-locations), and the hidden input
 # carrying the value actually submitted.
 #
 # Expected context:
 #  - chained:     {data (location tree), selected (current value)}
 #  - name, id:    name and id of the field
 #  - is_required: whether the field is mandatory
-#}
<script src="{{ js_path('/plugins/metademands/lib/cascading-dropdowns/jquery.chained.selects.js') }}"></script>
<select class="chained-select" name="{{ name }}-dropdown" id="{{ id }}-dropdown"{% if is_required %} required{% endif %}
        data-md-chained-locations="{{ chained|merge({target: id})|json_encode }}"></select>
<input type="hidden" name="{{ name }}" id="{{ id }}">
