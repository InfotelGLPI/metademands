{#-
 # Anchor of the location card of a dropdown / Location field. Always rendered when the
 # option is on: public/scripts/wizard_form.js (data-md-location-card) reloads it from
 # ajax/locationCard.php whenever the input named config.field_name changes.
 #
 # Expected context:
 #  - config:  {url, fields_id, field_name}
 #  - current: id of the location shown at load time, 0 when none
 #  - card:    context of fields/location_card.html.twig, or null
-#}
<div class="md-location-card-anchor"
     data-md-location-card="{{ config|json_encode|e('html_attr') }}"
     data-md-location-card-current="{{ current }}">
    {%- if card is not null -%}
        {{ include('@metademands/fields/location_card.html.twig', card, with_context = false) }}
    {%- endif -%}
</div>
