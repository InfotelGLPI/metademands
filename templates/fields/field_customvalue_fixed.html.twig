{#-
 # Shared editing grid for a field whose "custom values" are a fixed set of
 # parameters (no rank/order, no add/delete rows): Basket, Link, Number, Range,
 # Yesno. Rendered INSIDE the <table> already opened by
 # field_customvalue_values.html.twig, so this template emits table rows only.
 # Each cell's inner HTML (a static __() label plus a framework widget such as
 # Dropdown::show*() or Html::input()) is captured server-side and injected as
 # raw; the template owns the <tr class="tab_bg_1"> / <td> grid and the trailing
 # submit row. `after_html` carries an optional trailing fragment such as the
 # markup produced by Html::closeForm().
-#}
{% for row in rows %}
   <tr class="tab_bg_1">
      {%- for cell in row %}
      <td{% if cell.colspan is defined and cell.colspan %} colspan="{{ cell.colspan }}"{% endif %}>{{ cell.html|raw }}</td>
      {%- endfor %}
   </tr>
{% endfor %}
   <tr class="tab_bg_1">
      <td>{{ submit_html|raw }}</td>
   </tr>
{%- if after_html is defined and after_html %}
{{ after_html|raw }}
{%- endif %}
