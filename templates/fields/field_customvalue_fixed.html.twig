{#-
 # Shared editing grid for a field whose "custom values" are a fixed set of
 # parameters (no rank/order, no add/delete rows): Basket, Link, Number, Range,
 # Yesno. Rendered INSIDE the <table> already opened by
 # field_customvalue_values.html.twig, so this template emits table rows only.
 #
 # Expected context:
 #  - rows: list of rows, each a list of cells {label, text, hint, colspan, widget}, all
 #    optional. widget = {type, name, value} with type among
 #      - yesno
 #      - number (options: min, max, step)
 #      - array (elements, display_emptychoice)
 #      - text (size)
 #  - close_form: close the form opened by the caller (Range)
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# The widgets sit in table cells: no label, no column class #}
{% set bare = {'no_label': true, 'field_class': '', 'mb': ''} %}

{% for row in rows %}
   <tr class="tab_bg_1">
      {%- for cell in row %}
      {%- set widget = cell.widget|default(null) %}
      <td{% if cell.colspan|default(0) %} colspan="{{ cell.colspan }}"{% endif %}>
         {%- if cell.label|default('') is not empty %}<label>{{ cell.label }}</label>&nbsp;{% endif -%}
         {{- cell.text|default('') -}}
         {%- if widget is null -%}
         {%- elseif widget.type == 'yesno' -%}
            {{ fields.dropdownYesNo(widget.name, widget.value, '', bare) }}
         {%- elseif widget.type == 'number' -%}
            {{ fields.dropdownNumberField(widget.name, widget.value, '', bare|merge(widget.options|default({}))) }}
         {%- elseif widget.type == 'array' -%}
            {{ fields.dropdownArrayField(widget.name, widget.value, widget.elements, '', bare|merge({
               'display_emptychoice': widget.display_emptychoice|default(false),
            })) }}
         {%- elseif widget.type == 'text' -%}
            {{ fields.textField(widget.name, widget.value, '', bare|merge({'size': widget.size|default(30)})) }}
         {%- endif -%}
         {%- if cell.hint|default('') is not empty %}<br><i>{{ cell.hint }}</i>{% endif -%}
      </td>
      {%- endfor %}
   </tr>
{% endfor %}
   <tr class="tab_bg_1">
      <td>
         <button type="submit" value="" name="update" class="btn btn-primary"><i class="ti ti-device-floppy"></i>&nbsp;<span></span></button>
      </td>
   </tr>
{%- if close_form|default(false) %}
</form>
{%- endif %}
