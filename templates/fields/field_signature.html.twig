{#- Legacy-identical concatenation order: wrapper+canvas, optional existing-signature
 #  preview, buttons, result span, hidden input, then the script/css asset tags and the
 #  inline SignaturePad <script>. ids, name, labels and value are data and are escaped.
 #  script_tag / css_tag / inline_script are core-widget / generated output injected raw.
 #  Escaping is byte-identical to the legacy htmlspecialchars(ENT_QUOTES) for valid UTF-8.
 #  One physical line so no inter-element whitespace enters the output. -#}
<div class='wrapper'>
    <canvas id='{{ canvas_id }}' class='signature-pad' width=400 height=100></canvas>
</div>{% if has_value %}
<div id='existing-sign-{{ field_id }}'><img src='{{ picture_url }}' style='max-height:100px;border:1px solid #ccc;'>
</div>{% endif %}<br>
<div>
    <button type='button' id='{{ save_id }}' class='btn btn-primary'>{{ label_add }}</button>
    <button type='button' id='{{ clear_id }}' class='btn btn-primary'>{{ label_clear }}</button>
</div><br><span class='result' id='{{ result_id }}'></span><input type='hidden' id='{{ hidden_id }}'
                                                                      name='{{ name }}'
                                                                      value='{{ value }}'>{{ script_tag|raw }}{{ css_tag|raw }}{{ inline_script|raw }}
{#- -#}
