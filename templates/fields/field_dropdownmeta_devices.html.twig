{#- Whole "my devices" picker of a metademand field: the requester's own devices,
 #  then the ones their groups hold.
 #
 #  Expected context:
 #    sections : list of {title, separator, items, empty_message} kept in display order
 #    alert    : 'on' to light the mandatory-field warning up, 'off' to switch it off,
 #               '' to leave it as the caller rendered it
-#}
<div class="container" style="display:contents;" data-metademands-devices data-metademands-alert="{{ alert }}">
    <div class="row" data-toggle="buttons" style="margin-left: 1px;">
        {% for section in sections %}
            {% if section.separator %}<br>{% endif %}
            <span data-toggle="buttons" style="margin-bottom: 15px;">
                <h5>{{ section.title }}</h5>
                {% include '@metademands/fields/field_dropdownmeta_device.html.twig' with {'items': section.items} only %}
                {%- if section.empty_message is not empty %}{{ section.empty_message }}{% endif -%}
            </span>
        {% endfor %}
    </div>
</div>
