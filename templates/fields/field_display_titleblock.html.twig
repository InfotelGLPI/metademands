{#- Block title of the wizard (Fields\Titleblock::showWizardField()).
 #
 #  - label, icon, color, bg_color, rank: title, look, collapse target
 #  - label2, comment: rich texts of the designer, sanitized here
 #  - config_url: link to the field settings in the preview
-#}
{% import '@metademands/fields/field_wrapper.html.twig' as wrapper %}
{% if is_preview_or_debug %}
<div class="card-header preview-md md-preview-tag preview-md-{{ rank }}"
     style='background-color: {{ bg_color }}!important;border-color: {{ color }}!important;border-radius: 0;border-top:none;margin-bottom: 10px;'
     data-title='{{ rank }}'>
    {% else %}
    <div class='card-header'
         style='background-color: {{ bg_color }}!important;border-color: {{ color }}!important;border-radius: 0;border-top:none;margin-bottom: 10px;'>
        {% endif %}
        <h2 class="card-title"><span style='color:{{ color }};font-weight: normal;'>
        {%- if has_icon -%}
            {%- if icon_is_fa -%}
                <i class='fa-2x fas {{ icon }}'
                   style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands';"></i>&nbsp;
            {%- else -%}
                <i class='ti {{ icon }}' style="font-size:2em;"></i>&nbsp;
            {%- endif -%}
        {%- endif -%}
                {{- label -}}
                {%- if debug %} (ID:{{ id }}){% endif -%}
                {{- wrapper.config_link(config_url) -}}
                {%- if has_label2 %}&nbsp;<span class="form-help" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ label2|safe_html|e }}">?</span>{% endif -%}
        <i id='up{{ rank }}' class='ti ti-chevron-up pointer' data-metademands-collapse='{{ rank }}'
           style='right:40px;position: absolute;color:{{ color }};'></i>
    </span></h2>
    </div>
    {%- if has_comment %}
        <div class='card-body'><i>{{ comment|safe_html }}</i></div>{% endif %}
