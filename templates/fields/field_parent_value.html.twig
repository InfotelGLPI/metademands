{#
 # Read only rendering of a "father's field" value: the hidden inputs carry the parent
 # value back on submission, the displayed values come from the database and are escaped
 # by Twig. `is_html` is set only for the field types whose getFieldValue() returns markup
 # by contract (signature, textarea), both already sanitised on the PHP side.
 #}
{%- for input in inputs -%}
    <input type="hidden" name="{{ input.name }}" value="{{ input.value }}">
{%- endfor -%}
{%- for value in values -%}
    {%- if not loop.first %}<br>{% endif -%}
    {%- if is_html %}{{ value|raw }}{% else %}{{ value }}{% endif -%}
{%- endfor -%}
