{#-
 # Shared "value to check" editing row of a field's condition configuration.
 # The label is auto-escaped by {{ }}. Framework-produced markup (the optional
 # regex cell, the value dropdown cell together with its reload <script>, and
 # the linked task/field rows) is captured server-side and injected as raw.
 # The opening <tr> is intentionally left unclosed: it is closed by the first
 # <tr> emitted inside link_html (FieldOption::showLinkHtml), matching legacy.
-#}
<tr{% if row_class %} class="{{ row_class }}"{% endif %}>
   <td colspan="{{ label_colspan }}">{{ label }}</td>
   {{- regex_html|raw }}
   {{- valuetocheck_html|raw }}
{{ link_html|raw }}
