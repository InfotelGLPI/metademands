<div class='alert {{ display_class }} alert-dismissible fade show informations'
     style='display:flex;align-items: center;'>
    {%- if show_content -%}
        {%- if has_icon -%}
            {%- if icon_is_fa -%}
                <i class='fas fa-2x {{ icon }}' style='color:{{ color }};'></i>&nbsp;
            {%- else -%}
                <i class='ti {{ icon }}' style='font-size:2em;color:{{ color }};'></i>&nbsp;
            {%- endif -%}
        {%- endif -%}
        <div style='color:{{ color }};'>{{ name }}{{ comment_html|raw }}{{ label2_html|raw }}</div>
    {%- endif -%}
    {%- if preview %}{{ config_link|raw }}{% endif -%}
</div>
