{#
 # "Type of value to check" cell, next to the value cell it drives.
 #
 # Expected context (include it with `only`):
 #  - option_id: id of the option being edited
 #  - content:   the check_type_value dropdown fragment
 #}

<td style="text-align: right"
    data-md-option-id="{{ option_id }}"
    data-md-check-type="1"
    data-md-tech-group="1">
    {{ content|raw }}
</td>
