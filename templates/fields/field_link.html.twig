{#- Link field widget. The URL is normalised PHP side (an http:// scheme is forced
 #  when none is present), and rendered through an autoescaped href: the legacy
 #  onclick="window.open('...')" handler is gone, so there is no JS-in-attribute
 #  context left for a quote to break out of. -#}
{%- if mode == 'button' -%}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer"
       class="submit btn btn-primary" style="margin-top: 5px;">{{ label }}</a>
{%- elseif mode == 'link_a' -%}
    <a href="{{ url }}" target="_blank" rel="noopener noreferrer">{{ label }}</a>
{%- endif -%}
{%- if input_name is not empty -%}
    <input type="hidden" name="{{ input_name }}" value="{{ input_value }}">
{%- endif -%}
{#- -#}
