{#-
 # Bootstrap input group wrapping a field rendered by one of the ajax/u*Update.php
 # endpoints, which the caller includes and captures. The wrapper used to be opened
 # and closed by two `echo` around that include.
 #
 # Expected context:
 #  - id:      identifier of the group, targeted by the reload scripts
 #  - content: captured markup of the included endpoint
-#}
<div id="{{ id }}" class="input-group">{{ content|raw }}</div>
