{#
 # "Value to check" cell of an option row. The data-* attributes replace the inline
 # <script> that used to be emitted next to every cell; they are read by
 # public/scripts/fieldoption_valuetocheck.js.
 #
 # Expected context (include it with `only`):
 #  - option_id:          id of the option being edited
 #  - with_check_type:    the field type also exposes a check_type_value dropdown
 #  - with_tech_group:    the field type also exposes an assign_tech_group selector
 #  - content:            widget fragment, already built by showValueToCheck()/showRegexInput()
 #}

<td class="dropdown-valuetocheck"
    data-md-option-id="{{ option_id }}"
    data-md-check-type="{{ with_check_type ? '1' : '0' }}"
    data-md-tech-group="{{ with_tech_group ? '1' : '0' }}">
    {{ content|raw }}
</td>
