{#-
 # Specific parameters of a date field (Fields\Date / Datetime::showFieldParameters()):
 # values only, the widgets come from the core macros.
 #
 # Expected context:
 #  - used_by_child, use_future_date, use_date_now: yes / no
 #  - additional_number_day: days added to the default date
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# The widgets sit in grid columns: no label, no column class #}
{% set bare = {'no_label': true, 'field_class': '', 'mb': ''} %}

<div class="card mt-2">
    <div class="card-header">
        <h5 class="card-title">{{ __('Specific parameters', 'metademands') }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-center mb-2">
            <label
                class="col-sm-3 col-form-label">{{ __('Use this field for child ticket field', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownYesNo('used_by_child', used_by_child, '', bare) }}</div>
            <label class="col-sm-3 col-form-label">{{ __('Day greater or equal to now', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownYesNo('use_future_date', use_future_date, '', bare) }}</div>
        </div>
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-3 col-form-label">{{ __('Define the default date', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownYesNo('use_date_now', use_date_now, '', bare) }}</div>
            <label
                class="col-sm-3 col-form-label">{{ __('Additional number day to the default date', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownNumberField('additional_number_day', additional_number_day, '', bare|merge({'min': 0, 'max': 500})) }}</div>
        </div>
    </div>
</div>
