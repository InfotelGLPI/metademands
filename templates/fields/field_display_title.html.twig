{#- Title of the wizard (Fields\Title::showWizardField()): a section heading inside its block,
 #  small capitals over a thin line, as in the mockup of the wizard.
 #
 #  - label, icon: title and its icon
 #  - custom_color: colour chosen by the designer, empty for the default one (the theme
 #    colours then apply); color is its fallback for the callers not giving it
 #  - label2, comment: rich texts of the designer, sanitized here
 #  - preview, config_url: link to the field settings in the preview
-#}
{% import '@metademands/fields/field_wrapper.html.twig' as wrapper %}
{%- set section_color = custom_color ?? color ?? '' -%}
<div id-field='field{{ id }}' class='md-section-title'
     {%- if section_color is not empty %} style='--md-section-color: {{ section_color }};'{% endif %}>
    <h3 class='md-section-title-text'>
        {%- if has_icon -%}
            {%- if icon_is_fa -%}
                <i class='fas {{ icon }}'
                   style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands';"></i>
            {%- else -%}
                <i class='ti {{ icon }}'></i>
            {%- endif -%}
        {%- endif -%}
        <span>
            {{- label -}}
            {%- if debug %} (ID:{{ id }}){% endif -%}
        </span>
        {%- if has_label2 %}<span class="form-help" data-bs-toggle="tooltip" data-bs-placement="top" data-bs-html="true" data-bs-title="{{ label2|safe_html|e }}">?</span>{% endif -%}
        {%- if preview %}{{ wrapper.config_link(config_url) }}{% endif -%}
    </h3>
    {%- if has_comment %}
        <div class='md-section-title-comment'><i>{{ comment|safe_html }}</i></div>
    {%- endif %}
</div>
