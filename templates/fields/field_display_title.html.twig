<div id-field='field{{ id }}' class='card-header'
     style='background-color: {{ color_rgba }}!important;border-color:{{ color }}!important;border-radius: 0;margin-bottom: 10px;'>
    <br>
    <h2 class='card-title'><span style='color:{{ color }};font-weight: normal;'>
        {%- if has_icon -%}
            {%- if icon_is_fa -%}
                <i class='fa-2x fas {{ icon }}'
                   style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands';"></i>&nbsp;
            {%- else -%}
                <i class='ti {{ icon }}' style="font-size:2em;"></i>&nbsp;
            {%- endif -%}
        {%- endif -%}
            {{- label -}}
            {%- if debug %} (ID:{{ id }}){% endif -%}
            {%- if has_label2 %}&nbsp;{{ label2_tooltip_html|raw }}{% endif -%}
            {%- if preview %}{{ config_link|raw }}{% endif -%}
    </span></h2>
</div>
{%- if has_comment %}
    <div class='card-body'><i>{{ comment_html|raw }}</i></div>{% endif %}
