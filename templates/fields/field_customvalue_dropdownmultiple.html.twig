{#-
 # Editing grid for a "Dropdown multiple" field's custom values. Rendered INSIDE
 # the <table> already opened by field_customvalue_values.html.twig, so it emits
 # rows only. Faithful to the legacy method: the outer <tr><td> is opened and
 # deliberately left unclosed (the wrapping dispatcher table owns the closing).
 # Three modes:
 #   - objects: the field is bound to a GLPI itemtype; render a form + table of
 #     that itemtype's items, each with a default-value dropdown and a
 #     "display in dropdown" checkbox. `hidden_fields` are the hidden inputs
 #     (name => value), the (un)select all links are wired by
 #     public/scripts/wizard_form.js (data-md-check-all), each item
 #     carries its key, name, default value and checked state.
 #   - list: free custom values, delegated to field_customvalue_list.html.twig
 #     with the `list` context built by FieldCustomvalue::getListContext().
 #   - empty: itemtype is User or Location; nothing but the open <tr><td>.
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# The widgets sit in table cells: no label, no column class #}
{% set bare = {'no_label': true, 'field_class': '', 'mb': ''} %}

<tr>
   <td>
{%- if mode == 'objects' %}
   <form method="post" id="customvalues_form" action="{{ form_target }}">
      {%- for hidden_name, hidden_value in hidden_fields %}
      <input type="hidden" name="{{ hidden_name }}" value="{{ hidden_value }}">
      {%- endfor %}
      <table class="tab_cadre_fixe">
         <tr class="tab_bg_1">
            <th>{{ type_name }}</th>
            <th width="20%">{{ default_value_label }}</th>
            <th width="20%">
               {{ display_dropdown_label }}<br>
               <a href="#" data-md-check-all="1">{{ select_all_label }}</a> / <a href="#" data-md-check-all="0">{{ unselect_all_label }}</a>
            </th>
         </tr>
         {%- for it in items %}
         <tr class="tab_bg_1">
            <td><span id="custom_values{{ it.key }}">{{ it.name }}</span></td>
            <td width="20%"><span id="default_values{{ it.key }}">{{ fields.dropdownYesNo('default[' ~ it.key ~ ']', it.default, '', bare) }}</span></td>
            <td width="20%"><span id="present_values{{ it.key }}"><input type="checkbox" name="custom[{{ it.key }}]" value="{{ it.key }}"{% if it.checked %} checked{% endif %} /></span></td>
         </tr>
         {%- endfor %}
         <tr class="tab_bg_1">
            <td>
               <button type="submit" value="" name="update" class="btn btn-primary"><i class="ti ti-device-floppy"></i>&nbsp;<span></span></button>
            </td>
         </tr>
      </table>
      <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
   </form>
{%- elseif mode == 'list' %}
{% include '@metademands/fields/field_customvalue_list.html.twig' with list only %}
{%- endif %}
