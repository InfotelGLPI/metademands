{#-
 # Specific parameters of a yes / no field (Fields\Yesno::showFieldParameters()): values only.
 #
 # Expected context:
 #  - display_type, display_types: current display, available ones (value => label)
 #  - show_switch_warning: the switch display skips the mandatory check
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# The widgets sit in grid columns: no label, no column class #}
{% set bare = {'no_label': true, 'field_class': '', 'mb': ''} %}

<div class="card mt-2">
    <div class="card-header">
        <h5 class="card-title">{{ __('Specific parameters', 'metademands') }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-3 col-form-label">{{ __('Display type of the field', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownArrayField('display_type', display_type, display_types, '', bare) }}</div>
        </div>
    </div>
</div>
{% if show_switch_warning %}
    <div class="alert alert-warning mt-2">
        {{ __("Warning: switch mode don't support mandatory field check", 'metademands') }}
    </div>
{% endif %}
