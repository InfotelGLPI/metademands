{#- Block display of a GLPI object dropdown (Fields\Dropdownmeta::getFieldInput()).
 #
 #  - options: {key, name, has_icon, icon, icon_is_fa, comment, is_checked}, comment being
 #    the rich text of the option
 #  - namefield, id, is_required: field
-#}
{%- apply spaceless -%}
    {%- for opt in options -%}
        <div class='col-12 col-lg-6 col-xxl-4 mb-2'><label class='form-selectgroup-boxes flex-fill w-100 h-100'
                                                           style='min-height: 70px;'>
                <div class='form-selectgroup-label d-flex align-items-center h-100 shadow-none p-0 px-3'>
                    {%- if opt.has_icon -%}
                        <span class='me-2 mt-1'>
{%- if opt.icon_is_fa -%}
    <i class='fas {{ opt.icon }} fa-2x text-secondary'
       style="font-family:'Font Awesome 6 Free', 'Font Awesome 6 Brands';"></i>
{%- else -%}
    <i class='ti {{ opt.icon }} text-secondary' style='font-size: 3em'></i>
{%- endif -%}
</span>
                    {%- endif -%}
                    <div class='text-start'>
                        <div class='d-flex align-items-center'>{{ opt.name }}</div>
                        <small class='form-hint'>{{ opt.comment|safe_html }}</small></div>
                    <div class='me-2 ms-auto'><input{% if is_required %} required="required"{% endif %} class='form-check-input' type='radio'
                                                                        name='{{ namefield }}[{{ id }}]'
                                                                        id='{{ namefield }}[{{ id }}][{{ opt.key }}]'
                                                                        value='{{ opt.key }}'{% if opt.is_checked %} checked{% endif %}>
                    </div>
                </div>
            </label></div>
    {%- endfor -%}
{%- endapply -%}
