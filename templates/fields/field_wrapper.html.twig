<div id-field='field{{ id }}' class="{{ wrapper_class }}">{% if is_basket %}
    <h4 class='card-title mb-2 text-break' style='color: #a83d3d;'>{% endif %}
        {%- if render_label %}
        {%- if hide_title_zero %}
        {%- if hidden_zero %}
            <div class='col-form-label metademand-label'>
                {%- if has_icon %}<i class='ti {{ icon }}'></i>&nbsp;{% endif -%}
                {{- label }} {{ upload|raw -}}
                {%- if debug %} (ID:{{ id }}){% endif -%}
                {%- if preview %}{{ config_link|raw }}{% endif -%}
                {%- if show_comment_tooltip %}&nbsp;{{ comment_tooltip_html|raw }}{% endif -%}
                <span class='metademands_wizard_red'
                      id='metademands_wizard_red{{ id }}'>{% if is_mandatory_star %}*{% endif %}</span>
            </div>
        {%- endif %}
    {%- else %}
        <div style='margin-top: 10px;'>{% if preview %}{{ config_link|raw }}{% endif %}
            {%- endif %}
        {%- if is_basket %}</h4>{% endif %}
    {%- endif %}
    {%- if show_label2_alert %}
        <div class='alert alert-secondary' style='padding: 10px;'>
        <div class='remove-last-tinymce-margin'>{{ label2_alert_html|raw }}</div></div>{% endif %}
    {{- field_html|raw -}}
    {%- if close_hidetitle_div %}</div>{% endif %}
{%- if is_interval %}</div>
<div id-field='field{{ id }}-2' class="form-group col-md-6 md-bottom">
    <div for='field[{{ id }}-2]' class='col-form-label metademand-label'>{{ interval_label_html|raw }}
        <span {{ interval_required_class|raw }}>{{ interval_required_icon|raw }}</span>
    </div>{{ interval_html|raw }}{% endif %}
</div>
