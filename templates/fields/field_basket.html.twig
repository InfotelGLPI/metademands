{#- Cell contract: {t: text} is auto-escaped (Reference/Designation), {h: html} is
 #  injected raw (pre-sanitized getSafeHtml description, captured widget + inline
 #  script, formatted price, checkbox input). Optional {attrs} for the total-display
 #  td. background_style / header labels / placeholders are trusted (admin colour,
 #  translations) and emitted raw for byte-identity. Rendered on one physical line so
 #  no inter-element whitespace enters the output; the harness trims edge whitespace. -#}
<table class='tab_cadre_fixehov' style='{{ background_style|raw }}'>
    <tr class='tab_bg_1'>{% for header in headers %}
            <th style='{{ header.style|raw }}'>{{ header.label|raw }}</th>{% endfor %}</tr>{% if nb > 1 %}
    <tr class='tab_bg_1'>
        <th style='{{ background_style|raw }}'><input type='text' id='searchref-{{ search_id }}' size='10'
                                                      placeholder='{{ ph_ref|raw }}'></th>
        <th style='{{ background_style|raw }}'><input type='text' id='searchname-{{ search_id }}'
                                                      placeholder='{{ ph_name|raw }}'></th>
        <th style='{{ background_style|raw }}'><input type='text' id='searchdescription-{{ search_id }}'
                                                      placeholder='{{ ph_desc|raw }}'></th>
        <th colspan='4' style='{{ background_style|raw }}'></th>
    </tr>
    <tbody id='tablesearch-{{ search_id }}'>{% else %}
    <tbody>{% endif %}{% for row in rows %}
        <tr class='tab_bg_1'>{% for cell in row %}{% if cell.t is defined %}
            <td>{{ cell.t }}</td>{% else %}
            <td{{ cell.attrs|raw }}>{{ cell.h|raw }}</td>{% endif %}{% endfor %}</tr>{% endfor %}</tbody>
</table>{{ search_script|raw }}
{#- -#}
