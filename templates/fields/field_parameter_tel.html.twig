{#-
 # Specific parameters of a phone field (Fields\Tel::showFieldParameters()): values only, the widgets come from the core macros.
 #
 # Expected context:
 #  - link_to_user, user_fields: linked user field (id => label of the user fields of the meta-demand)
 #  - show_user_info, used_by_ticket, user_info_options: user information copied into the field
 #  - regex: regular expression the answer must match
-#}
{% import 'components/form/fields_macros.html.twig' as fields %}

{# The widgets sit in grid columns: no label, no column class #}
{% set bare = {'no_label': true, 'field_class': '', 'mb': ''} %}

<div class="card mt-2">
    <div class="card-header">
        <h5 class="card-title">{{ __('Specific parameters', 'metademands') }}</h5>
    </div>
    <div class="card-body">
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-3 col-form-label">{{ __('Link this to a user field', 'metademands') }}</label>
            <div class="col-sm-3">{{ fields.dropdownArrayField('link_to_user', link_to_user, user_fields, '', bare) }}</div>
            {% if show_user_info %}
                <label class="col-sm-3 col-form-label">{{ __('User information to get', 'metademands') }}</label>
                <div class="col-sm-3">{{ fields.dropdownArrayField('used_by_ticket', used_by_ticket, user_info_options, '', bare) }}</div>
            {% endif %}
        </div>
        <div class="row g-2 align-items-center mb-2">
            <label class="col-sm-3 col-form-label">{{ __('Regex to respect', 'metademands') }}</label>
            <div class="col-sm-9">{{ fields.textField('regex', regex, '', bare|merge({'additional_attributes': {'size': 50}})) }}</div>
        </div>
    </div>
</div>
