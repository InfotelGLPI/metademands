{#- Legacy-identical order: for each already-uploaded file, its (user-controlled) name,
 #  a &nbsp;, the delete mini-form and a <br>; then the Html::file uploader (possibly
 #  empty when max_upload is already reached) and the Html::scriptBlock. file.name is
 #  auto-escaped by {{ }} — a deliberate hardening of the raw legacy filename sink.
 #  delete_form / file_input / script are core-widget / generated output injected raw.
 #  One physical line so no inter-element whitespace enters the output. -#}
{% for file in files %}{{ file.name }}&nbsp;{{ file.delete_form|raw }}
    <br>{% endfor %}{{ file_input|raw }}{{ script|raw }}
{#- -#}
