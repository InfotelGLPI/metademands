{#- Upload field (Fields\Upload::showWizardField()).
 #
 #  - files: already uploaded files {name, post}, post holding the fields of the delete
 #    request, posted to delete_url like Html::getSimpleForm() does
 #  - file_options: options of Html::file(), null when max_upload is already reached
 #  One physical line so no inter-element whitespace enters the output.
-#}
{% for file in files %}{{ file.name }}&nbsp;{% set post = {'delete_basket_file': 'delete_basket_file'}|merge(file.post)|merge({'_glpi_simple_form': 1}) %}<a  class='pointer'  onclick="submitGetLink({{ delete_url|json_encode }}, {{ post|json_encode }});" ><span class='fas fa-times-circle' title='{{ _x('button', 'Delete permanently') }}'><span class='sr-only'>{{ _x('button', 'Delete permanently') }}</span></span></a>
    <br>{% endfor %}{% if file_options is not null %}{% do call('Html::file', [file_options]) %}{% endif %}
{#- -#}
