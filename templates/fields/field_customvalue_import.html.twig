<tr class="tab_bg_1">
    <td align="right">
        <a href="javascript:void(0);" class="btn btn-success" onclick='formToggle("importFrm");'>
            {{- __('Reset and import custom values', 'metademands') -}}
        </a>
    </td>
    <td align="left" colspan="4">
        <div class="col-md-12" id="importFrm" style="display: none;">
            <form name="form" method="post" action="{{ import_action }}" enctype="multipart/form-data">
                <input type="file" name="importFrm" id="importFrm">&nbsp;
                {{ hidden_html|raw }}
                {{ submit_html|raw }}
                {{ tooltip_html|raw }}
                <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
            </form>
        </div>
        {{ script_html|raw }}
    </td>
</tr>
