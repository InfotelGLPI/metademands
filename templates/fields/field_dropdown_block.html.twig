{%- if options is not empty -%}
    <div class='row flex-row'>
        {%- for opt in options -%}
            <div class='col-12 col-lg-6 col-xxl-4 mb-2'><label class='form-selectgroup-boxes flex-fill w-100 h-100'
                                                               style='min-height: 70px;'>
                    <div
                        class='form-selectgroup-label d-flex align-items-center h-100 shadow-none p-0 px-3'>{% if has_icon %}
                        <span class='me-2 mt-1'><i class='ti {{ icon }} text-secondary'></i></span>{% endif %}
                        <div class='text-start'>
                            <div class='d-flex align-items-center'>{{ opt.name }}</div>
                            <small class='form-hint'>{{ opt.comment_html|raw }}</small></div>
                        <div class='me-2 ms-auto'><input {{ required|raw }} class='form-check-input' type='radio'
                                                                            name='{{ namefield }}[{{ id }}]'
                                                                            id='{{ namefield }}[{{ id }}][{{ opt.key }}]'
                                                                            value='{{ opt.key }}' {{ opt.checked|raw }}>
                        </div>
                    </div>
                </label></div>
        {%- endfor -%}
    </div>
{%- endif %}
