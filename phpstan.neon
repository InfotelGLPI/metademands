includes:
    - ../../vendor/glpi-project/phpstan-glpi/extension.neon
    - phpstan-baseline.neon

parameters:
    level: 5
    paths:
        - ajax
        - front
        - install
        - src
        - hook.php
        - setup.php
    scanDirectories:
        - ../../inc
        - ../../src
    scanFiles:
        # Local stub for the optional datainjection plugin (see the stub header).
        # Keeps analysis independent of where datainjection lives, or if absent.
        - tools/phpstan-stubs/datainjection.php
    bootstrapFiles:
        - ../../stubs/glpi_constants.php
        - ../../vendor/autoload.php
        - setup.php
    treatPhpDocTypesAsCertain: false
    # The CI runner analyzes a pristine GLPI 11.0.x core while the local tree may
    # carry core modifications, so PHPStan's type narrowing (and baseline hit counts)
    # can differ between the two. Tolerate baseline entries that do not reproduce on
    # the runner instead of failing on the drift.
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # GLPI_ALLOW_IFRAME_IN_RICH_TEXT is a config-overridable core constant
        # (config/local_define.php). On the pristine runner core PHPStan resolves it
        # to its literal default and flags this guard branch as dead, while a locally
        # modified core does not narrow it. The branch mirrors the core rich-text
        # renderer and must stay; ignore the environment-dependent narrowing here.
        -
            identifier: booleanNot.alwaysFalse
            path: src/Fields/Textarea.php
